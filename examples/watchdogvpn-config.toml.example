# WatchdogVPN persistent configuration example.
#
# This file is planned for /etc/watchdogvpn/config.toml in v0.2.0.
# It must not contain credentials, tokens, account data or private keys.

[backend]
mode = "custom-vps"
active = "custom-vps"

[custom_vps]
enabled = false
name = ""
host = ""
ssh_user = ""
ssh_port = 22
protocol = ""
profile_path = ""
service_name = ""
interface = ""

[language]
current = "en"
auto_detect = true

[dns]
advanced_mode = false
profile = "quad9-doh"

[tui]
theme = "default"
color = true
unicode = true

[reporting]
sanitize_ipv4 = true
sanitize_ipv6 = true
sanitize_email = true
sanitize_home = true

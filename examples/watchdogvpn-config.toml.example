# WatchdogVPN persistent configuration example.
#
# This file is planned for /etc/watchdogvpn/config.toml in v0.2.0.
# It must not contain credentials, tokens, account data or private keys.

[language]
current = "en"
auto_detect = true

[timers]
watchdog_interval = "5min"
rotation_interval = "12h"

[dns]
advanced_mode = false
profile = "quad9-doh"

[tui]
theme = "default"
color = true
unicode = true

[reporting]
sanitize_ipv4 = true
sanitize_ipv6 = true
sanitize_email = true
sanitize_home = true

http:
  pprof:
    port: 6060
    enabled: false
  address: 127.0.0.1:3000
  session_ttl: 720h
users: []
auth_attempts: 5
block_auth_min: 15
http_proxy: ""
language: en
theme: auto
dns:
  bind_hosts:
    - 127.0.0.1
  port: 53
  upstream_dns:
    - https://dns10.quad9.net/dns-query
    - https://dns11.quad9.net/dns-query
  bootstrap_dns:
    - 9.9.9.10
    - 149.112.112.10
  fallback_dns:
    - https://cloudflare-dns.com/dns-query
    - https://dns.google/dns-query
  upstream_mode: load_balance
  cache_enabled: true
  cache_size: 4194304
  cache_ttl_min: 60
  cache_ttl_max: 3600
  cache_optimistic: true
  refuse_any: true
  serve_plain_dns: true
tls:
  enabled: false
querylog:
  enabled: true
  file_enabled: true
statistics:
  enabled: true
filters:
  - enabled: true
    url: https://adguardteam.github.io/HostlistsRegistry/assets/filter_1.txt
    name: AdGuard DNS filter
    id: 1
whitelist_filters: []
user_rules: []
dhcp:
  enabled: false
filtering:
  filtering_enabled: true
  protection_enabled: true
clients:
  persistent: []
log:
  enabled: true
schema_version: 34

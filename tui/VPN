        }
        hints = extra_hints.get(section, [])
        if hints and y < head_h + body_h:
            y += 1
            write(y, right_x + 2, "Notas", FG["blue"] + BOLD)
            y += 2
            for hint in hints:
                if y >= head_h + body_h:
                    break
                for wrapped in textwrap.wrap(hint, max(20, right_w - 6)) or [""]:
                    if y >= head_h + body_h:
                        break
                    write(y, right_x + 4, f"• {fit(wrapped, right_w - 8)}", FG["gray"])
                    y += 1


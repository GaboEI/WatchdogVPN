                item = data["by_component"].get(component)
                if item:
                    value = f"{item['level']} · {item['event']}"
                    style = trace_level_style(item["level"])
                else:
                    value = "sin datos nuevos"
                    style = FG["gray"]
                write(y, 3, fit(component, 14), FG["white"])
                write(y, 18, fit(value, left_w - 20), style)
                y += 1

        y = head_h + 2
        if not data["entries"]:
            write(y, right_x + 2, "Sin entradas parseables todavia.", FG["yellow"] + BOLD)
            write(y + 2, right_x + 2, "Ejecuta watchdog, rotate o dispatcher para generar logs nuevos.", FG["gray"])
        else:
            recent = data["important"] or data["entries"][-10:]
            for item in reversed(recent):
                if y >= head_h + body_h:
                    break
                head = f"{item['timestamp']}  {item['component']}  {item['level']}  {item['event']}"
                write(y, right_x + 2, fit(head, right_w - 4), trace_level_style(item["level"]))
                y += 1
                if y >= head_h + body_h:
                    break
                write(y, right_x + 4, fit(item["detail"], right_w - 8), FG["gray"])
                y += 2

        write(help_y + 1, 3, "r", FG["cyan"] + BOLD)
        write(help_y + 1, 5, "refrescar", FG["yellow"] + BOLD)
        write(help_y + 1, 17, "q/Esc/←", FG["cyan"] + BOLD)
        write(help_y + 1, 26, "volver", FG["yellow"] + BOLD)
        sys.stdout.flush()

        key = read_key()
        if key in ("q", "esc", "left", "enter"):
            set_status("Trazabilidad vista")
            return
        if key == "r":
            set_status("Trazabilidad refrescada")
            continue



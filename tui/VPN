        f"sudo -n {cli} config reset tui --yes"
    )


def update_center_repo_root():
    candidates = [
        os.environ.get("WATCHDOGVPN_REPO", ""),
        os.getcwd(),
        os.path.abspath(os.path.join(SCRIPT_DIR, os.pardir)),
        os.path.expanduser("~/WatchdogVPN"),
        os.path.expanduser("~/watchdogvpn"),
    ]
    seen = set()
    for candidate in candidates:
        if not candidate:
            continue
        path = os.path.abspath(os.path.expanduser(candidate))
        if path in seen:
            continue
        seen.add(path)
        if os.path.isdir(os.path.join(path, ".git")) and os.path.isfile(os.path.join(path, "bin", "watchdogvpn")):
            return path
    return ""


def update_center_snapshot():
    repo_root = update_center_repo_root()

    def local(cmd: str, timeout: int = 4) -> str:
        if not repo_root:
            return ""
        return run(f"cd {shlex.quote(repo_root)} && {cmd} 2>/dev/null || true", timeout).strip()

    installed_version = run(f"{shlex.quote(WATCHDOGVPN_CLI)} version 2>/dev/null || true", 4).strip()
    local_version = local("./bin/watchdogvpn version") if repo_root else ""
    upstream = local("git rev-parse --abbrev-ref --symbolic-full-name @{u}")
    remote_commit = local("git rev-parse --short @{u}") if upstream else ""
    counts = local("git rev-list --left-right --count HEAD...@{u}") if upstream else ""
    dirty = bool(local("git status --porcelain"))
    ahead, behind = 0, 0
    if counts:
        parts = counts.split()
        if len(parts) >= 2 and parts[0].isdigit() and parts[1].isdigit():
            ahead, behind = int(parts[0]), int(parts[1])

    if not upstream:
        remote_state = "no upstream"
    elif ahead and behind:
        remote_state = "diverged"
    elif behind:
        remote_state = "behind"
    elif ahead:
        remote_state = "ahead"
    else:
        remote_state = "up to date"
    local_state = "dirty" if dirty else "clean"

    return [
        ("Version", installed_version or local_version or "unknown"),
        ("Repo", repo_root or "not found"),
        ("Source checkout", "found" if repo_root else "not found"),
        ("Branch", local("git branch --show-current") or "unknown"),
        ("Commit", local("git rev-parse --short HEAD") or "unknown"),
        ("Upstream", upstream or "unknown"),
        ("Origin", remote_commit or "unknown"),
        ("Estado remoto", remote_state),
        ("Cambios locales", local_state),
        ("Ahead/behind", f"{ahead}/{behind}" if upstream else "unknown"),
        ("Ultimo tag", local("git tag --list 'v*' --sort=-version:refname | head -n 1") or "unknown"),
        ("Estado", local("git status --short --branch | head -n 1") or "unknown"),
    ]


def update_center_recommendations(snapshot=None):
    data = dict(snapshot or update_center_snapshot())
    remote_state = data.get("Estado remoto", "unknown")
    local_state = data.get("Cambios locales", "unknown")

    recommendations = []
    if local_state == "dirty":
        recommendations.append("  git status --short")
        recommendations.append("  git add ... && git commit -m \"...\"")
    if remote_state == "behind":
        recommendations.append("  git pull --ff-only origin main")
    elif remote_state == "ahead":
        recommendations.append("  git push origin main")
    elif remote_state == "diverged":
        recommendations.append("  git log --oneline --graph --decorate --all -n 20")
        recommendations.append("  # revisar antes de mezclar ramas")
    elif remote_state == "no upstream":
        recommendations.append("  git branch --set-upstream-to=origin/main main")
    elif remote_state == "up to date" and local_state == "clean":
        recommendations.append("  # repo local limpio y alineado con origin/main conocido")
    if not recommendations:
        recommendations.append("  git status --short --branch")
    return recommendations


def update_center_fetch_command() -> str:
    repo_root = update_center_repo_root()
    if not repo_root:
        return "printf '%s\\n' 'Source checkout not found. Open ~/WatchdogVPN or set WATCHDOGVPN_REPO.'"
    return f"cd {shlex.quote(repo_root)} && git fetch origin --tags && git status --short --branch"


def update_center_runtime_status(snapshot=None) -> str:
    data = dict(snapshot or update_center_snapshot())
    if data.get("Source checkout", "found") != "found":
        return "Source checkout missing"
    if data.get("Cambios locales") == "dirty":
        return "Local changes need review"
    remote_state = data.get("Estado remoto", "unknown")
    if remote_state == "up to date":
        return "Ready"
    if remote_state == "behind":
        return "Update available"
    if remote_state == "ahead":
        return "Publish local changes"
    if remote_state == "diverged":
        return "Manual review required"
    if remote_state == "no upstream":
        return "Setup needed"
    return "Unknown"



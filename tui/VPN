                ("Ejecutar watchdog", f"sudo systemctl restart {WATCHDOG_TIMER}; sudo env VPN_WATCHDOG_FORCE=1 {shlex.quote('/usr/local/sbin/vpn_watchdog.sh')}; {TRUTH_BIN}"),
                ("Estado real", f"{VPNCTL} status"),
            ],
            "Timers": [
                ("Activar rotacion", f"sudo systemctl start {ROTATE_TIMER} {ROTATE_FIRSTBOOT_TIMER} && systemctl status {ROTATE_TIMER} --no-pager -n 8"),
                ("Parar rotacion", f"sudo systemctl stop {ROTATE_TIMER} {ROTATE_FIRSTBOOT_TIMER} && systemctl status {ROTATE_TIMER} --no-pager -n 8"),
                ("Intervalo rotacion", "__SET_ROTATE__"),
                ("Activar watchdog", f"sudo systemctl start {WATCHDOG_TIMER} && systemctl status {WATCHDOG_TIMER} --no-pager -n 8"),
                ("Parar watchdog", f"sudo systemctl stop {WATCHDOG_TIMER} && systemctl status {WATCHDOG_TIMER} --no-pager -n 8"),
                ("Intervalo watchdog", "__SET_WATCHDOG__"),
            ],
            "Bypass dominios": [
                ("Ver lista", f"sudo -n {shlex.quote(NO_VPN)} --list"),
                ("Agregar dominio", "__ADD_BYPASS__"),
                ("Quitar dominio", "__REMOVE_BYPASS__"),
            ],
            "DNS / AdGuard": [
                ("DNS actual", f"sudo -n {shlex.quote(DNSCTL)} current"),
                ("Aplicar Quad9", "__DNS_APPLY__:quad9-doh"),
                ("Aplicar Cloudflare", "__DNS_APPLY__:cloudflare-doh"),
                ("Aplicar Google", "__DNS_APPLY__:google-doh"),
                ("Aplicar AdGuard DoQ", "__DNS_APPLY__:adguard-doq"),
                ("Aplicar OpenDNS", "__DNS_APPLY__:opendns-doh"),
                ("Aplicar AdGuard sin filtro", "__DNS_APPLY__:adguard-unfiltered-doh"),
                ("Aplicar AdGuard filtrado", "__DNS_APPLY__:adguard-doh"),
                ("Rollback DNS", "__DNS_ROLLBACK__"),
            ],
            "Ver logs": [
                ("Resumen trazabilidad", "__TRACE_SUMMARY__"),
                ("Housekeeping logs", "__HOUSEKEEPING__"),
                ("vpn-watchdog.log", "sudo tac /var/log/myvpn/vpn-watchdog.log 2>/dev/null | head -n 120"),
                ("vpn-rotate.log", "sudo tac /var/log/myvpn/vpn-rotate.log 2>/dev/null | head -n 120"),
                ("vpn-dispatcher.log", "sudo tac /var/log/vpn-dispatcher.log 2>/dev/null | head -n 120"),
                ("journal adguardvpn.service", "sudo journalctl -r -u adguardvpn.service -n 120 --no-pager"),
            ],
            "Pool de rotacion": [
                ("Ver configuracion", "sudo grep -E '^(TOP_N|RECENT_KEEP)=' /usr/local/sbin/vpn_rotate.sh"),
                ("TOP_N = 10", "__TOPN_10__"),
                ("TOP_N = 15", "__TOPN_15__"),
                ("TOP_N = 20", "__TOPN_20__"),
                ("TOP_N = 30", "__TOPN_30__"),

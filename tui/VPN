            else:
                if "sudo" in action and not ensure_sudo():
                    continue
                set_status(action_label)
                show_output(action_label, run_with_progress(action_label, action_progress_text(label, action_label), action, 50))
                if label in ("Acciones rapidas", "Timers", "Exclusiones", "Pool de rotacion"):
                    set_status(f"Listo: {action_label}")
                    return True
    except Exception:
        show_output(f"Error: {label}", traceback.format_exc())
        set_status(f"Error en {label}")
        return False


def main():
    global term
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print("VPN requiere una terminal interactiva.")
        return
    term = Terminal()
    atexit.register(term.exit)
    term.enter()
    apply_tui_preferences()
    sudo_ready = initialize_sudo()
    selected = 0
    dashboard_cache = refresh_dashboard()
    set_status("Sudo activo" if sudo_ready else "Modo limitado: sudo no disponible")
    last_auto_refresh = time.monotonic()
    dashboard_lock = threading.Lock()
    dashboard_refreshing = False
    dashboard_pending = None
    redraw = True

    def queue_dashboard_refresh():
        nonlocal dashboard_refreshing, dashboard_pending
        with dashboard_lock:
            if dashboard_refreshing:
                return
            dashboard_refreshing = True

        def worker():
            nonlocal dashboard_refreshing, dashboard_pending
            try:
                data = refresh_dashboard(quiet=True)
            except Exception:
                data = None
            with dashboard_lock:
                if data is not None:
                    dashboard_pending = data
                dashboard_refreshing = False

        thread = threading.Thread(target=worker, daemon=True)
        thread.start()

    def consume_dashboard_refresh() -> bool:
        nonlocal dashboard_cache, dashboard_pending
        with dashboard_lock:
            if dashboard_pending is None:
                return False
            dashboard_cache = dashboard_pending
            dashboard_pending = None
            return True

    def request_exit() -> bool:
        if confirm_exit():
            set_status("Saliendo")
            return True
        set_status("Salida cancelada")
        return False

    while True:
        if redraw:
            render(selected, dashboard_cache)
            redraw = False
        timeout = None
        if menu_id(selected) == "dashboard":
            timeout = 0.2
        key = read_key(timeout)
        if consume_dashboard_refresh():
            redraw = True
        if is_mouse_click(key):
            x, y = mouse_xy(key)
            clicked = main_menu_index_at(x, y, selected) if x is not None else None
            if clicked is None:
                continue
            selected = clicked
            if menu_id(selected) == "exit":
                if request_exit():
                    break
                redraw = True
                continue
            set_status(f"Abriendo: {menu_label(selected)}")
            try:
                changed = handle_menu(menu_section(selected))
            except Exception:
                show_output("VPN error", traceback.format_exc())
                changed = False
            if changed:
                dashboard_cache = refresh_dashboard()
                last_auto_refresh = time.monotonic()
            redraw = True
            continue
        if key in ("q", "esc"):
            if request_exit():
                break
            redraw = True
            continue
        if key == "left":
            continue
        if key is None:
            if menu_id(selected) == "dashboard" and (time.monotonic() - last_auto_refresh) >= DASHBOARD_REFRESH_SECONDS:
                queue_dashboard_refresh()
                last_auto_refresh = time.monotonic()
            continue
        if key == "r":
            dashboard_cache = refresh_dashboard()
            last_auto_refresh = time.monotonic()
            set_status("Dashboard refrescado")
            redraw = True
        elif key == "down" and selected < len(MENU) - 1:
            selected += 1
            set_status(menu_label(selected))
            redraw = True
        elif key == "up" and selected > 0:
            selected -= 1
            set_status(menu_label(selected))
            redraw = True
        elif key in ("enter", "right"):
            if menu_id(selected) == "exit":
                if request_exit():
                    break
                redraw = True
                continue
            set_status(f"Abriendo: {menu_label(selected)}")
            try:
                changed = handle_menu(menu_section(selected))
            except Exception:
                show_output("VPN error", traceback.format_exc())
                changed = False
            if changed:
                dashboard_cache = refresh_dashboard()
                last_auto_refresh = time.monotonic()
            redraw = True


if __name__ == "__main__":
    main()

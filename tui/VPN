def sudo_keepalive_loop():
    while not SUDO_KEEPALIVE_STOP.wait(SUDO_KEEPALIVE_SECONDS):
        sudo_probe()


def start_sudo_keepalive():
    global SUDO_KEEPALIVE_THREAD
    if SUDO_KEEPALIVE_THREAD and SUDO_KEEPALIVE_THREAD.is_alive():
        return
    SUDO_KEEPALIVE_STOP.clear()
    SUDO_KEEPALIVE_THREAD = threading.Thread(target=sudo_keepalive_loop, daemon=True)
    SUDO_KEEPALIVE_THREAD.start()


def stop_sudo_keepalive():
    SUDO_KEEPALIVE_STOP.set()
    if SUDO_KEEPALIVE_THREAD and SUDO_KEEPALIVE_THREAD.is_alive():
        SUDO_KEEPALIVE_THREAD.join(timeout=0.2)


atexit.register(stop_sudo_keepalive)


def ensure_sudo(
    title: str = "Sudo requerido",
    prompt: str = "Introduce tu contrasena sudo para acciones del VPN.",
) -> bool:
    if sudo_probe():
        start_sudo_keepalive()
        return True
    password = prompt_secret(title, prompt)
    if password is None:
        set_status("Sudo cancelado")
        return False
    auth = run_with_input("sudo -S -p '' -v", password + "\n", 12)
    if not auth or auth.returncode != 0:
        set_status("Sudo fallido")
        show_output("Sudo", ((auth.stdout or "") + (auth.stderr or "")).strip() or "Autenticacion sudo fallida.")
        return False
    start_sudo_keepalive()
    set_status("Sudo validado")
    return True


def initialize_sudo() -> bool:
    ok = ensure_sudo(
        "Sudo inicial",
        "Introduce tu contrasena sudo para abrir VPN con control completo.",
    )
    if ok:
        set_status("Sudo activo")
        return True
    set_status("Modo limitado: sudo no disponible")
    return False


def can_list_locations_without_prompt() -> bool:
    probe = run_process(
        f"timeout 4s sudo -n -u adgvpn -H {shlex.quote(AG)} version >/dev/null 2>&1",
        5,
    )
    return bool(probe and probe.returncode == 0)


def load_locations():
    raw = run(
        r"""timeout 10s sudo -n -u adgvpn -H """
        + shlex.quote(AG)
        + r""" list-locations 2>/dev/null | sed -E $'s/\x1B\[[0-9;]*[[:alpha:]]//g'""",
        12,
    )
    lower = raw.lower()
    if "timed out" in lower:
        return []
    if "sudo:" in lower or "password" in lower:
        return None
    if "please log in" in lower or "you can log in" in lower:
        return []
    out = strip_ansi(raw)
    items = []
    for raw_line in out.splitlines():
        line = raw_line.strip()
        if not line:
            continue
        if not re.match(r"^[A-Z][A-Z]\s", line):
            continue
        cols = re.split(r"\s{2,}", line)
        if not cols or not re.match(r"^[A-Z]{2}$", cols[0]):
            continue
        iso = cols[0]
        country = cols[1] if len(cols) > 1 else ""
        city = cols[2] if len(cols) > 2 else ""
        ping = cols[3] if len(cols) > 3 else ""
        desc = f"{flag_from_iso(iso)} {iso}  {country}  {city}  {ping}ms".strip()
        items.append(
            {
                "iso": iso,
                "country": country,
                "city": city,
                "ping": ping,
                "raw": line,
                "desc": re.sub(r"\s+", " ", desc).strip(),
            }
        )
    return items



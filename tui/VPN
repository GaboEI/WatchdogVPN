def build_history_text(limit: int = 20) -> str:
    raw = run(rf"sudo -n tail -n {int(limit)} /var/log/myvpn/vpn-events.log 2>/dev/null || true", 5)
    lines = [
        "Historial de eventos",
        "-------------------",
        "Fuente: /var/log/myvpn/vpn-events.log",
        "Orden: mas reciente primero",
        "",
    ]
    if not raw or raw.startswith("ERROR"):
        lines.append("Sin eventos registrados todavia.")
    else:
        for line in reversed(raw.splitlines()):
            event = parse_event_line(line)
            if not event:
                lines.append(line)
                continue
            marker = {
                "critical": "ERROR",
                "normal": "INFO",
                "low": "LOW",
            }.get(event["urgency"], event["urgency"].upper())
            lines.append(f"{marker:<8} {event['title']}: {event['body']}")
    lines.append("")
    lines.append("Pulsa q para volver.")
    return "\n".join(lines)



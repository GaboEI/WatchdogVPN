    offset = 0
    while True:
        rows, cols = get_size()
        clear()
        head_h = 3
        foot_h = 2
        body_h = max(12, min(rows - head_h - foot_h - 1, 18))
        left_w = 32
        right_x = left_w + 2
        right_w = cols - right_x - 1
        help_y = head_h + body_h + 2

        box(1, 1, head_h, cols - 2, section)
        box(head_h + 1, 1, body_h, left_w, "Opciones")
        box(head_h + 1, right_x, body_h, right_w, "Detalle")
        box(help_y, 1, foot_h + 1, cols - 2, "Ayuda")

        write(2, 3, fit(section_intro(section), cols - 6), FG["gray"])

        visible_h = max(1, body_h - 2)
        if idx < offset:
            offset = idx
        if idx >= offset + visible_h:
            offset = idx - visible_h + 1
        visible = items[offset : offset + visible_h]
        for i, (label, _) in enumerate(visible):
            absolute_idx = offset + i
            selected = absolute_idx == idx
            style = BG["cyan"] + FG["black"] + BOLD if selected else FG["gray"]
            prefix = "› " if selected else "  "
            write(head_h + 2 + i, 2, (prefix + fit(label, left_w - 6)).ljust(left_w - 3), style)

        y = head_h + 2
        selected_label = items[idx][0]
        write(y, right_x + 2, fit(selected_label, right_w - 4), FG["cyan"] + BOLD)
        y += 2
        meta = section_meta(section, selected_label)
        if meta:
            write(y, right_x + 2, "Contexto operativo", FG["blue"] + BOLD)
            y += 2
        for key, value in meta:
            if y >= head_h + body_h:
                break
            write(y, right_x + 2, f"{key:<10}", FG["magenta"] + BOLD)
            write(y, right_x + 14, fit(value, right_w - 16), semantic_style(key, value))
            y += 1

        extra_hints = {

class Terminal:
    def __init__(self):
        self.fd = sys.stdin.fileno()
        self.old = termios.tcgetattr(self.fd)

    def enter(self):
        tty.setraw(self.fd)
        sys.stdout.write(
            CSI + "?1049h"
            + CSI + "?25l"
            + CSI + "?1000h"
            + CSI + "?1006h"
            + CSI + "2J"
            + CSI + "H"
        )
        sys.stdout.flush()

    def exit(self):
        termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old)
        sys.stdout.write(RESET + CSI + "?1000l" + CSI + "?1006l" + CSI + "?25h" + CSI + "?1049l")
        sys.stdout.flush()


term = Terminal()
atexit.register(term.exit)



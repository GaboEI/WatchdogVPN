def mouse_event(seq: bytes):
    m = re.match(rb"\[<(\d+);(\d+);(\d+)([mM])", seq)
    if not m:
        return None
    code = int(m.group(1))
    x = int(m.group(2))
    y = int(m.group(3))
    suffix = m.group(4)
    if code == 64:
        return "up"
    if code == 65:
        return "down"
    if suffix == b"m":
        return ("mouse_release", x, y)
    button = code & 3
    if button == 0:
        return ("mouse_left", x, y)
    if button == 1:
        return ("mouse_middle", x, y)
    if button == 2:
        return ("mouse_right", x, y)
    return ("mouse", x, y)


def is_mouse_click(key) -> bool:
    return isinstance(key, tuple) and key and key[0] == "mouse_left"


def mouse_xy(key):
    if isinstance(key, tuple) and len(key) >= 3:
        return key[1], key[2]
    return None, None



def settings_set_command(key: str, value: str) -> str:
    allowed = {
        "language.current",
        "tui.theme",
        "tui.color",
        "tui.unicode",
    }
    if key not in allowed:
        return "echo 'ERROR: clave settings no permitida.'"
    return (
        f"sudo -n {shlex.quote(WATCHDOGVPN_CLI)} config set "
        f"{shlex.quote(key)} {shlex.quote(value)}"
    )


def settings_reset_command() -> str:
    cli = shlex.quote(WATCHDOGVPN_CLI)
    return (

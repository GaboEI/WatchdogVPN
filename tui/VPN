            write(help_y + 1, cols - 18, f"{idx + 1}/{len(items)}", FG["gray"])
        sys.stdout.flush()

        key = read_key(text_mode=True)
        if is_mouse_click(key):
            x, y = mouse_xy(key)
            row = y - (head_h + 2)
            if x is not None and 0 <= row < len(visible) and 1 <= x <= left_w:
                idx = offset + row
                return str(idx + 1)
            if x is not None and right_x <= x <= right_x + right_w and head_h + 1 <= y <= head_h + body_h:
                return str(idx + 1)
            continue
        if key in ("esc", "left", "q", "char:q", "char:Q"):
            return None
        if key in ("enter", "right"):
            return str(idx + 1)
        if key == "down" and idx < len(items) - 1:
            idx += 1
        if key == "up" and idx > 0:
            idx -= 1
        if key == "char:g":
            idx = 0
        if key == "char:G":
            idx = len(items) - 1



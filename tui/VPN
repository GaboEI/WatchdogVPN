            write(3 + i, 3, line.ljust(body_w), style)
        write(rows - 2, 3, "↑↓ mover   Enter seleccionar   q volver", FG["yellow"] + BOLD)
        sys.stdout.flush()
        key = read_key(text_mode=True)
        if is_mouse_click(key):
            x, y = mouse_xy(key)
            row = y - 3
            if x is not None and 0 <= row < len(visible):
                idx = offset + row
                return items[idx][0]
            continue
        if key in ("q", "char:q", "char:Q", "esc", "left"):
            return None
        if key in ("enter", "right"):
            return items[idx][0]
        if key == "down" and idx < len(items) - 1:
            idx += 1
        if key == "up" and idx > 0:
            idx -= 1


def prompt_input(title: str, prompt: str):
    def clean_paste(text: str) -> str:
        return "".join(ch for ch in text if 32 <= ord(ch) <= 126)

    def read_bracketed_paste(timeout: float = 5.0) -> str:
        end = b"\x1b[201~"
        data = bytearray()
        tail = bytearray()
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            if not select.select([sys.stdin], [], [], 0.2)[0]:
                continue
            tail += os.read(sys.stdin.fileno(), 1)
            if tail.endswith(end):
                data.extend(tail[:-len(end)])
                return clean_paste(data.decode("utf-8", "ignore"))
            if len(tail) > len(end):
                data.append(tail[0])
                del tail[0]
        data.extend(tail)
        return clean_paste(data.decode("utf-8", "ignore"))

    value = ""
    while True:
        rows, cols = get_size()
        clear()
        w = min(80, cols - 4)
        x = max(2, (cols - w) // 2)
        y = max(2, rows // 2 - 3)
        box(y, x, 7, w, title)
        write(y + 2, x + 2, fit(prompt, w - 4), FG["white"])
        write(y + 4, x + 2, fit(value, w - 4), FG["cyan"] + BOLD)
        write(y + 5, x + 2, "Enter confirmar   Esc cancelar", FG["yellow"])
        sys.stdout.flush()
        ch = os.read(sys.stdin.fileno(), 1)
        if ch in (b"\r", b"\n"):
            set_status(f"{title} captured")
            return value.strip()
        if ch == b"\x1b":
            seq = bytearray()
            while select.select([sys.stdin], [], [], 0.01)[0] and len(seq) < 6:
                seq += os.read(sys.stdin.fileno(), 1)
                if seq.endswith(b"~"):
                    break
            if bytes(seq) == b"[200~":
                value += read_bracketed_paste()
                continue
            set_status(f"Cancelado: {title}")
            return None
        if ch in (b"\x7f", b"\b"):
            value = value[:-1]
        elif 32 <= ord(ch) <= 126:
            value += ch.decode("utf-8", "ignore")



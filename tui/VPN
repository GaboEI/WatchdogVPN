                    domain = domain_or_error
                    if not ensure_sudo():
                        continue
                    set_status(f"Agregando bypass {domain}")
                    output = run_with_progress(
                        action_label,
                        f"Aplicando bypass para {domain}",
                        f"sudo -n {shlex.quote(NO_VPN)} {shlex.quote(domain)}",
                        75,
                    )
                    show_output(action_label, output)
                    set_status(f"Bypass actualizado: {domain}")
                    return True
            elif action == "__REMOVE_BYPASS__":
                if not ensure_sudo():
                    continue
                domains = bypass_domains()
                if not domains:
                    show_output(action_label, "No hay dominios configurados para quitar.")
                    return False
                domain = select_list("Quitar dominio", [(d, d) for d in domains])
                if domain:
                    set_status(f"Quitando bypass {domain}")
                    output = run_with_progress(
                        action_label,
                        f"Quitando bypass para {domain}",
                        remove_bypass_domain_command(domain),
                        45,
                    )
                    show_output(action_label, output)
                    set_status(f"Bypass eliminado: {domain}")
                    return True
            elif action == "__SET_ROTATE__":
                if not ensure_sudo():
                    continue
                val = select_list("Intervalo de rotacion", [(x, x) for x in ["1h", "2h", "3h", "6h", "12h"]])
                if val:
                    set_status(f"Ajustando rotacion a {val}")
                    show_output(action_label, run_with_progress(action_label, f"Ajustando rotacion a {val}", set_timer_interval_command(ROTATE_TIMER, val), 30))
                    set_status(f"Rotacion: {val}")
                    return True
            elif action == "__SET_WATCHDOG__":
                if not ensure_sudo():
                    continue
                val = select_list("Intervalo del watchdog", [(x, x) for x in ["1min", "2min", "3min", "5min"]])
                if val:
                    set_status(f"Ajustando watchdog a {val}")
                    show_output(action_label, run_with_progress(action_label, f"Ajustando watchdog a {val}", set_timer_interval_command(WATCHDOG_TIMER, val), 30))
                    set_status(f"Watchdog: {val}")
                    return True
            elif action in ("__TOPN_10__", "__TOPN_15__", "__TOPN_20__", "__TOPN_30__"):
                if not ensure_sudo():
                    continue
                value_map = {
                    "__TOPN_10__": "10",
                    "__TOPN_15__": "15",
                    "__TOPN_20__": "20",
                    "__TOPN_30__": "30",
                }
                value = value_map[action]
                set_status(f"Ajustando TOP_N a {value}")
                show_output(action_label, run_with_progress(action_label, f"Ajustando TOP_N a {value}", set_rotate_top_n_command(value), 30))
                set_status(f"TOP_N aplicado: {value}")
                return True
            elif action == "__TOPN_CUSTOM__":
                if not ensure_sudo():
                    continue
                value = prompt_input("TOP_N custom", "Escribe un numero entre 1 y 100.")
                if value:
                    if not re.match(r"^[0-9]+$", value.strip()) or not (1 <= int(value.strip()) <= 100):
                        alert("TOP_N invalido", "TOP_N debe ser un numero entero entre 1 y 100.")
                        set_status("TOP_N invalido")
                        continue
                    set_status(f"Ajustando TOP_N a {value}")
                    show_output(action_label, run_with_progress(action_label, f"Ajustando TOP_N a {value}", set_rotate_top_n_command(value), 30))
                    set_status(f"TOP_N aplicado: {value}")
                    return True
            elif isinstance(action, str) and action.startswith("__DNS_APPLY__:"):
                profile = action.split(":", 1)[1]
                if not ensure_sudo():
                    continue
                if not confirm_dns_apply(profile):
                    set_status("Cambio DNS cancelado")
                    continue
                set_status(f"Aplicando DNS {profile}")
                output = run_with_progress(
                    action_label,
                    f"Aplicando DNS {DNS_PROFILE_LABELS.get(profile, profile)}",
                    f"sudo -n {shlex.quote(DNSCTL)} apply {shlex.quote(profile)}",

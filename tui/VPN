def location_panel(items):
    idx = 0
    offset = 0
    query = ""
    while True:
        filtered = [
            item for item in items
            if not query
            or query.lower() in item["iso"].lower()
            or query.lower() in item["country"].lower()
            or query.lower() in item["city"].lower()
            or query.lower() in item["raw"].lower()
        ]
        if filtered:
            idx = max(0, min(idx, len(filtered) - 1))
        else:
            idx = 0
            offset = 0
        rows, cols = get_size()
        clear()
        head_h = 3
        foot_h = 2
        body_h = max(12, min(rows - head_h - foot_h - 1, 18))
        left_w = 36
        right_x = left_w + 2
        right_w = cols - right_x - 1
        help_y = head_h + body_h + 2

        box(1, 1, head_h, cols - 2, "Cambiar ubicacion")
        box(head_h + 1, 1, body_h, left_w, "Nodos")
        box(head_h + 1, right_x, body_h, right_w, "Detalle")
        box(help_y, 1, foot_h + 1, cols - 2, "Ayuda")

        write(2, 3, "Escribe ISO, pais o ciudad para filtrar. Enter aplica vpn_set sobre el nodo elegido.", FG["gray"])
        write(head_h + 2, 3, fit(f"Filtro: {query or '-'}", left_w - 4), FG["yellow"] + BOLD)

        visible_h = min(14, max(1, body_h - 5))
        if idx < offset:
            offset = idx
        if idx >= offset + visible_h:
            offset = idx - visible_h + 1
        visible = filtered[offset : offset + visible_h]

        flag_w = 2
        iso_w = 2
        ping_w = 5
        city_w = 12
        country_w = max(7, left_w - 3 - 2 - flag_w - iso_w - ping_w - city_w - 8)

        header = (
            "FG "
            + "ISO".ljust(iso_w + 1)
            + "Pais".ljust(country_w + 1)
            + "Ciudad".ljust(city_w + 1)
            + "Ping".rjust(ping_w)
        )
        write(head_h + 3, 3, fit(header, left_w - 4), FG["blue"] + BOLD)

        for i, item in enumerate(visible):
            selected = (offset + i) == idx
            style = BG["cyan"] + FG["black"] + BOLD if selected else FG["gray"]
            prefix = "›" if selected else " "
            line = (
                f"{prefix} "
                f"{fit(flag_from_iso(item['iso']) or '', flag_w):<{flag_w}} "
                f"{item['iso']:<{iso_w}} "
                f"{fit(item['country'], country_w):<{country_w}} "
                f"{fit(item['city'], city_w):<{city_w}} "
                f"{(item['ping'] + 'ms') if item['ping'] else '-':>{ping_w}}"
            )
            write(head_h + 4 + i, 2, line.ljust(left_w - 2), style)

        y = head_h + 2
        if filtered:
            node = filtered[idx]
            title = f'{flag_from_iso(node["iso"])} {node["iso"]} · {node["country"]}'
            if node["city"]:
                title += f" · {node['city']}"
            write(y, right_x + 2, fit(title, right_w - 4), FG["cyan"] + BOLD)
            y += 2

            meta = [
                ("ISO", node["iso"]),
                ("Pais", node["country"] or "-"),
                ("Ciudad", node["city"] or "-"),
                ("Ping", f'{node["ping"]} ms' if node["ping"] else "-"),
                ("Perfil", "Pool de rotacion"),
                ("Accion", f'vpn_set {node["iso"]}'),
            ]
            for key, value in meta:
                if y >= head_h + body_h:
                    break
                write(y, right_x + 2, f"{key:<10}", FG["magenta"] + BOLD)
                write(y, right_x + 14, fit(value, right_w - 16), semantic_style(key, value))
                y += 1

            if y < head_h + body_h:
                y += 1
                write(y, right_x + 2, "Notas", FG["blue"] + BOLD)
                y += 2
                notes = [
                    "Escribe para buscar por ISO, pais o ciudad.",
                    "Este selector no toca la logica del stack; solo aplica vpn_set sobre el ISO.",
                    "La ubicacion final sigue sujeta al comportamiento real del cliente y del servicio.",
                ]
                for note in notes:
                    for wrapped in textwrap.wrap(note, max(20, right_w - 6)) or [""]:
                        if y >= head_h + body_h:
                            break
                        write(y, right_x + 4, f"• {fit(wrapped, right_w - 8)}", FG["gray"])
                        y += 1
        else:
            write(y, right_x + 2, "Sin coincidencias", FG["yellow"] + BOLD)
            write(y + 2, right_x + 2, "Ajusta el filtro o usa Backspace para borrar.", FG["gray"])

        write(help_y + 1, 3, "↑↓", FG["cyan"] + BOLD)
        write(help_y + 1, 6, "mover", FG["yellow"] + BOLD)
        write(help_y + 1, 14, "Enter", FG["cyan"] + BOLD)
        write(help_y + 1, 21, "aplicar", FG["yellow"] + BOLD)
        write(help_y + 1, 31, "texto", FG["cyan"] + BOLD)
        write(help_y + 1, 37, "filtrar", FG["yellow"] + BOLD)
        write(help_y + 1, 47, "Esc/←", FG["cyan"] + BOLD)
        write(help_y + 1, 54, "volver", FG["yellow"] + BOLD)
        sys.stdout.flush()

        key = read_key(text_mode=True)
        if is_mouse_click(key):
            x, y = mouse_xy(key)
            row = y - (head_h + 4)
            if x is not None and filtered and 0 <= row < len(visible) and 1 <= x <= left_w:
                return visible[row]["iso"]
            if x is not None and filtered and right_x <= x <= right_x + right_w and head_h + 1 <= y <= head_h + body_h:
                return filtered[idx]["iso"]
            continue
        if key in ("esc", "left"):
            return None
        if key in ("enter", "right") and filtered:
            return filtered[idx]["iso"]
        if key == "down" and idx < len(filtered) - 1:
            idx += 1
        if key == "up" and idx > 0:
            idx -= 1
        if key == "backspace":
            query = query[:-1]
            idx = 0
            offset = 0
        if isinstance(key, str) and key.startswith("char:"):
            query += key.split(":", 1)[1]
            idx = 0
            offset = 0



def read_key(timeout: float | None = None, text_mode: bool = False):
    while True:
        r, _, _ = select.select([sys.stdin], [], [], timeout)
        if not r:
            return None
        timeout = None
        ch = os.read(sys.stdin.fileno(), 1)
        if not ch:
            continue
        if ch == b"\x1b":
            seq = b""
            while True:
                ready, _, _ = select.select([sys.stdin], [], [], 0.01)
                if not ready:
                    break
                seq += os.read(sys.stdin.fileno(), 1)
            if seq == b"":
                return "esc"
            if seq.startswith(b"[A"):
                return "up"
            if seq.startswith(b"[B"):
                return "down"
            if seq.startswith(b"[C"):
                return "right"
            if seq.startswith(b"[D"):
                return "left"
            if seq.startswith(b"[<"):
                event = mouse_event(seq)
                if event:
                    return event
                continue
            continue
        if ch in (b"\r", b"\n"):
            return "enter"
        if not text_mode and ch in (b"q", b"Q"):
            return "q"
        if not text_mode and ch in (b"r", b"R"):
            return "r"
        if ch in (b"\x7f", b"\b"):
            return "backspace"
        if 32 <= ord(ch) <= 126:
            return f"char:{ch.decode('utf-8', 'ignore')}"



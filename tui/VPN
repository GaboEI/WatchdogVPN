        write(help_y + 1, 6, "mover", FG["yellow"] + BOLD)
        write(help_y + 1, 14, "Enter", FG["cyan"] + BOLD)
        write(help_y + 1, 21, "abrir", FG["yellow"] + BOLD)
        write(help_y + 1, 29, "g/G", FG["cyan"] + BOLD)
        write(help_y + 1, 33, "inicio/final", FG["yellow"] + BOLD)
        write(help_y + 1, 47, "q", FG["cyan"] + BOLD)
        write(help_y + 1, 49, "volver", FG["yellow"] + BOLD)

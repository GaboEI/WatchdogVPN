def progress_phase(elapsed: int, timeout: int) -> str:
    if elapsed < 2:
        return "Preparando"
    if elapsed < max(4, timeout // 3):
        return "Ejecutando"
    if elapsed < max(8, (timeout * 2) // 3):
        return "Validando"
    return "Cerrando"


def progress_message(title: str, message: str, elapsed: int, frame: int = 0, timeout: int = 40):
    rows, cols = get_size()
    clear()
    w = min(74, cols - 4)
    h = 10
    x = max(2, (cols - w) // 2)
    y = max(2, rows // 2 - h // 2)
    spinner = "|/-\\"[frame % 4]
    bar_w = max(12, w - 12)
    filled = max(1, min(bar_w, int((elapsed / max(1, timeout)) * bar_w)))
    bar = ("█" * filled + "░" * (bar_w - filled))[:bar_w]
    box(y, x, h, w, title)
    write(y + 2, x + 3, f"{spinner} {progress_phase(elapsed, timeout)}", FG["yellow"] + BOLD)
    write(y + 3, x + 3, fit(message, w - 8), FG["white"])
    write(y + 5, x + 3, bar, FG["cyan"])
    write(y + 7, x + 3, f"Tiempo: {elapsed}s / limite: {timeout}s", FG["gray"])
    write(y + 8, x + 3, "No cierres la terminal. Si tarda, la operacion sigue viva.", FG["gray"])
    sys.stdout.flush()


def run_with_progress(title: str, message: str, cmd: str, timeout: int = 40) -> str:
    proc = run_command(cmd)
    if proc is None:
        return "ERROR: no pude iniciar el comando."

    chunks = []
    start = time.monotonic()
    frame = 0
    while True:
        elapsed = int(time.monotonic() - start)
        progress_message(title, message, elapsed, frame, timeout)
        frame += 1
        if proc.poll() is not None:
            break
        if elapsed >= timeout:
            proc.kill()
            chunks.append(f"\nERROR: timeout despues de {timeout}s")
            break
        time.sleep(0.2)

    try:
        out, _ = proc.communicate(timeout=1)
    except Exception:
        out = ""
    if out:
        chunks.append(out)
    return "".join(chunks).strip() or "(sin salida)"


def output_line_style(line: str) -> str:
    text = (line or "").strip()
    lower = text.lower()
    upper = text.upper()
    if text.startswith("==") or text.startswith("----"):
        return FG["cyan"] + BOLD
    if any(token in upper for token in ("APPLY_OK", "ROLLBACK_OK", "TRY_OK", "STATUS=UP", "IP=OK", "STATE_SAVED")):
        return FG["green"] + BOLD
    if upper.startswith("OK ") or upper == "OK" or " OK " in upper:
        return FG["green"] + BOLD
    if any(token in upper for token in ("ERROR", "FAIL", "FAILED", "IP=FAIL", "STATUS=DOWN", "TRACEBACK")):
        return FG["red"] + BOLD
    if any(token in upper for token in ("WARN", "WARNING", "DEGRADED", "UNKNOWN", "SKIP", "TIMEOUT")):
        return FG["yellow"] + BOLD
    if any(token in lower for token in ("backup=", "profile=", "config=", "rollback", "dns", "tun=", "route=", "ip_addr=")):
        return FG["blue"] + BOLD
    return FG["white"]



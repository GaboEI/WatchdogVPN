            write(y, right_x + 2, "Sin coincidencias", FG["yellow"] + BOLD)
            write(y + 2, right_x + 2, "Ajusta el filtro o usa Backspace para borrar.", FG["gray"])

        write(help_y + 1, 3, "↑↓", FG["cyan"] + BOLD)
        write(help_y + 1, 6, "mover", FG["yellow"] + BOLD)
        write(help_y + 1, 14, "Enter", FG["cyan"] + BOLD)
        write(help_y + 1, 21, "aplicar", FG["yellow"] + BOLD)
        write(help_y + 1, 31, "texto", FG["cyan"] + BOLD)
        write(help_y + 1, 37, "filtrar", FG["yellow"] + BOLD)
        write(help_y + 1, 47, "Esc/←", FG["cyan"] + BOLD)
        write(help_y + 1, 54, "volver", FG["yellow"] + BOLD)
        sys.stdout.flush()

        key = read_key(text_mode=True)
        if is_mouse_click(key):
            x, y = mouse_xy(key)
            row = y - (head_h + 4)
            if x is not None and filtered and 0 <= row < len(visible) and 1 <= x <= left_w:
                return visible[row]["iso"]
            if x is not None and filtered and right_x <= x <= right_x + right_w and head_h + 1 <= y <= head_h + body_h:
                return filtered[idx]["iso"]
            continue
        if key in ("esc", "left"):
            return None
        if key in ("enter", "right") and filtered:
            return filtered[idx]["iso"]
        if key == "down" and idx < len(filtered) - 1:
            idx += 1
        if key == "up" and idx > 0:
            idx -= 1
        if key == "backspace":
            query = query[:-1]
            idx = 0
            offset = 0
        if isinstance(key, str) and key.startswith("char:"):
            query += key.split(":", 1)[1]
            idx = 0
            offset = 0



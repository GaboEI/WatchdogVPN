# Generic disposable guest for the Phase 23.5/23.6 distro-certification lab.
#
# Usage (from this directory):
#   WDVPN_VM_BOX=<verified-box> WDVPN_VM_NAME=wdvpn-<target> \
#     WDVPN_VM_BRIDGE=<verified-host-interface> \
#     vagrant up --provider=virtualbox
#
# The box is intentionally an explicit maintainer input. The inventory records
# distro identity and phase ownership, but does not bless an arbitrary Vagrant
# Cloud image as a certification image. No provisioner is configured because
# install.sh itself is under test.

box = ENV.fetch("WDVPN_VM_BOX", "").strip
abort "WDVPN_VM_BOX must name a verified Vagrant box" if box.empty?

box_version = ENV.fetch("WDVPN_VM_BOX_VERSION", "").strip
machine_name = ENV.fetch("WDVPN_VM_NAME", "wdvpn-certification").strip
abort "WDVPN_VM_NAME must not be empty" if machine_name.empty?

bridge = ENV.fetch("WDVPN_VM_BRIDGE", "").strip
abort "WDVPN_VM_BRIDGE is required; certification VMs are bridge-only and must never use NAT" if bridge.empty?
cpus = Integer(ENV.fetch("WDVPN_VM_CPUS", "2"), 10)
memory = Integer(ENV.fetch("WDVPN_VM_MEMORY_MB", "4096"), 10)

Vagrant.configure("2") do |config|
  config.vm.box = box
  config.vm.box_version = box_version unless box_version.empty?
  config.vm.hostname = machine_name
  # Vagrant's normal SSH communicator depends on its implicit NAT adapter.
  # Certification uses a direct maintainer-controlled SSH channel over the
  # bridged LAN instead, so disabling the communicator is intentional.
  config.vm.communicator = "none"

  # Certification evidence must start from the selected box itself. The
  # vagrant-vbguest plugin otherwise installs compilers, DKMS and headers
  # during `vagrant up`, contaminating dependency provenance before
  # WatchdogVPN's installer is exercised.
  if Vagrant.has_plugin?("vagrant-vbguest")
    config.vbguest.auto_update = false
  end

  config.vm.provider "virtualbox" do |vb|
    vb.name = machine_name
    vb.cpus = cpus
    vb.memory = memory
    # VirtualBox otherwise injects adapter 1 as NAT even when a public network
    # is declared. Keep that path absent, not merely unused by the guest.
    vb.customize ["modifyvm", :id, "--nic1", "none"]
  end

  # The sole guest path is adapter 2 bridged to the explicitly selected host
  # interface. NAT has already produced protocol-specific interference and
  # can inherit an unrelated host VPN's policy route, invalidating egress
  # evidence. Source and fixtures are injected through the direct SSH channel.
  config.vm.network "public_network", bridge: bridge
end

{
  "schema_version": 1,
  "provider": "virtualbox",
  "network": "bridge-only-no-nat",
  "execution": "sequential-one-host",
  "targets": [
    {
      "id": "arch",
      "phase": "23.5",
      "adapter": "arch",
      "support_state": "certified_default_and_packaged_lts",
      "identity": {"id": "arch"},
      "kernel_policy": "distribution_default_plus_packaged_lts_before_broad_claim"
    },
    {
      "id": "cachyos",
      "phase": "23.5",
      "adapter": "arch",
      "support_state": "certified_via_arch_fallback",
      "identity": {"id_like_contains": "arch"},
      "kernel_policy": "distribution_default_at_certification_time",
      "additional_kernel_evidence": "Arch packaged LTS matrix plus any additionally advertised CachyOS flavor",
      "image_requirement": "maintainer-verified CachyOS VirtualBox image or locally built Vagrant box",
      "physical_validation": {
        "required_for_certification": false,
        "purpose": "optional separate controlled validation when suitable maintainer-owned hardware exists",
        "does_not_replace": "fresh_install_vm_certification",
        "requires_explicit_task_authorization": true
      }
    },
    {
      "id": "debian",
      "phase": "23.5",
      "adapter": "debian",
      "support_state": "certified_closed",
      "identity": {"id": "debian"},
      "kernel_policy": "distribution_default_at_certification_time"
    },
    {
      "id": "ubuntu",
      "phase": "23.5",
      "adapter": "ubuntu",
      "support_state": "certified_closed",
      "identity": {"id": "ubuntu"},
      "kernel_policy": "distribution_default_at_certification_time"
    },
    {
      "id": "fedora",
      "phase": "23.6",
      "adapter": "fedora",
      "support_state": "blocked_selinux_firewalld_lifecycle_and_certification",
      "identity": {"id": "fedora"},
      "kernel_policy": "distribution_default_at_certification_time",
      "image_requirement": "official Fedora image or maintainer-approved Fedora Vagrant box with checksum-pinned provenance; Cloud 44 Vagrant VirtualBox beta media is not enough by itself"
    },
    {
      "id": "opensuse",
      "phase": "23.6",
      "adapter": "opensuse",
      "support_state": "blocked_adapter_and_apparmor_audit",
      "identity": {"ids_include": ["opensuse-leap", "opensuse-tumbleweed"], "id_like_contains": "suse"},
      "kernel_policy": "distribution_default_at_certification_time",
      "image_requirement": "official openSUSE Leap or Tumbleweed Vagrant box; Leap 15.6 currently has the strongest bridge-SSH baseline evidence"
    },
    {
      "id": "debian-derivative",
      "phase": "23.6",
      "adapter": "debian_or_ubuntu_id_like_fallback",
      "support_state": "blocked_id_like_fallback",
      "identity": {"id_like_contains_any": ["debian", "ubuntu"]},
      "kernel_policy": "distribution_default_at_certification_time",
      "recommended_representative": "linux-mint"
    },
    {
      "id": "redhat-family-control",
      "phase": "23.6",
      "adapter": "fedora",
      "support_state": "blocked_lab_image_selection_and_selinux_firewalld_lifecycle",
      "identity": {"id_like_contains_any": ["rhel", "fedora"], "ids_include": ["rhel", "centos", "rocky", "almalinux"]},
      "kernel_policy": "distribution_default_at_certification_time",
      "recommended_representative": "almalinux-or-rocky",
      "image_requirement": "official RHEL only with maintainer-provided Red Hat access; otherwise maintainer-approved AlmaLinux/RockyLinux control with reachable bridge SSH baseline",
      "rhel_note": "Actual RHEL requires maintainer-provided Red Hat Developer/subscription access; compatible clones are controls, not RHEL certification."
    }
  ]
}

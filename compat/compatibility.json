  "capabilities": {
    "core_host_capabilities": {
      "cap_apparmor": {
        "description": "AppArmor reporting; never lowered for certification",
        "type": "diagnostic_only"
      },
      "cap_architecture": {
        "description": "Supported CPU architecture for selected methods",
        "type": "required"
      },
      "cap_dns_backend": {
        "description": "A supported DNS backend such as systemd-resolved, NetworkManager DNS, or resolv.conf",
        "type": "alternative"
      },
      "cap_kernel": {
        "description": "Linux kernel exposing the capabilities WatchdogVPN requires",
        "type": "required"
      },
      "cap_network_manager": {
        "description": "NetworkManager or an explicitly admitted equivalent",
        "type": "alternative"
      },
      "cap_nftables": {
        "description": "nftables backend required for the atomic kill switch",
        "type": "required"
      },
      "cap_package_manager": {
        "description": "Family package manager used for bootstrap and runtime packages",
        "type": "required"
      },
      "cap_persistence": {
        "description": "Installed state survives reboot and can be audited",
        "type": "required"
      },
      "cap_policy_routing": {
        "description": "ip rule and route capability required by capture and split tunnel",
        "type": "required"
      },
      "cap_polkit": {
        "description": "Polkit privileged-action support",
        "type": "required"
      },
      "cap_python310": {
        "description": "Final product runtime Python floor; bootstrap reader only requires Python 3.6",
        "type": "provisionable"
      },
      "cap_rollback": {
        "description": "Provisioner rollback and uninstall capability",
        "type": "required"
      },
      "cap_selinux": {
        "description": "SELinux reporting; never lowered for certification",
        "type": "diagnostic_only"
      },
      "cap_sudo": {
        "description": "Privilege elevation path",
        "type": "required"
      },
      "cap_systemd": {
        "description": "systemd init and service semantics",
        "type": "required"
      },
      "cap_tun": {
        "description": "/dev/net/tun support",
        "type": "required"
      }
    },
    "protocol_capabilities": {
      "proto_amneziawg_runtime": {
        "description": "awg tools plus AmneziaWG kernel module or amneziawg-go",
        "type": "provisionable"
      },
      "proto_ck_client_runtime": {
        "description": "Cloak ck-client runtime",
        "type": "provisionable"
      },
      "proto_openvpn_runtime": {
        "description": "OpenVPN runtime",
        "type": "provisionable"
      },
      "proto_sing_box_runtime": {
        "description": "sing-box runtime used by VLESS, Trojan, Hysteria2, VMess, TUIC, Shadowsocks, SOCKS and HTTP",
        "type": "provisionable"
      }
    }
  },

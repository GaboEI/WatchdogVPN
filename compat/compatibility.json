  "protocols": {
    "amneziawg": {
      "category": "resilient",
      "evidence_policy": "Real TUN, owned SOCKS and owned HTTP egress required for a green",
      "required_protocol_capabilities": [
        "proto_amneziawg_runtime"
      ]
    },
    "http": {
      "category": "compatibility",
      "evidence_policy": "Useful real HTTP proxy traffic required",
      "required_protocol_capabilities": [
        "proto_sing_box_runtime"
      ]
    },
    "hysteria2": {
      "category": "resilient",
      "evidence_policy": "Real TUN, owned SOCKS and owned HTTP egress required for a green",
      "required_protocol_capabilities": [
        "proto_sing_box_runtime"
      ]
    },
    "openvpn": {
      "category": "formal_non_green",
      "evidence_policy": "No false green: runtime/listener/TLS without egress remains non-green",
      "required_protocol_capabilities": [
        "proto_openvpn_runtime"
      ]
    },
    "openvpn_cloak": {
      "category": "resilient",
      "evidence_policy": "Real TUN, owned SOCKS and owned HTTP egress required for a green",
      "required_protocol_capabilities": [
        "proto_openvpn_runtime",
        "proto_ck_client_runtime"
      ]
    },
    "shadowsocks": {
      "category": "formal_non_green",
      "evidence_policy": "No false green: runtime/listener without useful egress remains non-green",
      "required_protocol_capabilities": [
        "proto_sing_box_runtime"
      ]
    },
    "socks": {
      "category": "compatibility",
      "evidence_policy": "Useful real SOCKS traffic required",
      "required_protocol_capabilities": [
        "proto_sing_box_runtime"
      ]
    },
    "trojan": {
      "category": "resilient",
      "evidence_policy": "Real TUN, owned SOCKS and owned HTTP egress required for a green",
      "required_protocol_capabilities": [
        "proto_sing_box_runtime"
      ]
    },
    "tuic": {
      "category": "compatibility",
      "evidence_policy": "Useful real traffic required",
      "required_protocol_capabilities": [
        "proto_sing_box_runtime"
      ]
    },
    "vless": {
      "category": "resilient",
      "evidence_policy": "Real TUN, owned SOCKS and owned HTTP egress required for a green",
      "required_protocol_capabilities": [
        "proto_sing_box_runtime"
      ]
    },
    "vmess": {

#!/usr/bin/env bash
set -euo pipefail

LOG_FILE="${VPN_NOTIFY_LOG:-/var/log/myvpn/vpn-events.log}"
DRY_RUN=0

usage() {
  cat <<'USAGE'
Uso:
  vpn_notify [--dry-run] "Titulo" "Mensaje" [low|normal|critical]
  vpn_notify --help

Registra un evento del stack VPN y, si existe una sesion grafica, envia una
notificacion de escritorio. El contrato posicional se mantiene por
compatibilidad con scripts existentes.
USAGE
}

while (($#)); do
  case "${1:-}" in
    --help|-h)
      usage
      exit 0
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "ERROR: argumento no reconocido: $1" >&2
      usage >&2
      exit 64
      ;;
    *)
      break
      ;;
  esac
done

TITLE="${1:-VPN}"
BODY="${2:-}"
URGENCY="${3:-normal}"

case "$URGENCY" in
  low|normal|critical) ;;
  *) URGENCY="normal" ;;
esac

level_for_urgency() {
  case "$URGENCY" in
    critical) printf 'ERROR' ;;
    *) printf 'INFO' ;;
  esac
}

event_for_title() {
  local raw="${TITLE:-VPN}"
  raw="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/_/g; s/^_+|_+$//g')"
  printf '%s' "${raw:-notification}"
}

quote_value() {
  local s="${1:-}"
  s="${s//\\/\\\\}"
  s="${s//\'/\\\'}"
  s="${s//$'\n'/ }"
  s="${s//$'\r'/ }"
  printf "'%s'" "$s"
}

ensure_log_dir() {
  local dir
  dir="$(dirname "$LOG_FILE")"
  [[ -d "$dir" ]] && return 0
  if (( EUID == 0 )); then
    install -d -m 0755 -o root -g root "$dir" 2>/dev/null || true
  fi
}

log_event() {
  local level event detail
  level="$(level_for_urgency)"
  event="$(event_for_title)"
  detail="title=$(quote_value "$TITLE") urgency=$(quote_value "$URGENCY") body=$(quote_value "$BODY")"

  ensure_log_dir
  if [[ -e "$LOG_FILE" && ! -w "$LOG_FILE" ]]; then
    return 0
  fi
  if [[ ! -e "$LOG_FILE" && ! -w "$(dirname "$LOG_FILE")" ]]; then
    return 0
  fi
  printf '%s | notify | %s | %s | %s\n' "$(date --iso-8601=seconds)" "$level" "$event" "$detail" >> "$LOG_FILE" 2>/dev/null || true
}

target_users() {
  local user

  user="${SUDO_USER:-}"
  if [[ -n "$user" && "$user" != "root" ]]; then
    printf '%s\n' "$user"
  fi

  user="$(logname 2>/dev/null || true)"
  if [[ -n "$user" && "$user" != "root" ]]; then
    printf '%s\n' "$user"
  fi

  loginctl list-sessions --no-legend 2>/dev/null \
    | awk '$3 != "root" {print $3}' \
    | sort -u || true
}

send_notify() {
  local user uid bus

  command -v notify-send >/dev/null 2>&1 || return 1

  while read -r user; do
    [[ -n "$user" ]] || continue
    uid="$(id -u "$user" 2>/dev/null || true)"
    [[ "$uid" =~ ^[0-9]+$ ]] || continue
    bus="/run/user/$uid/bus"
    [[ -S "$bus" ]] || continue

    runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" notify-send \
      --app-name="VPN" \
      --urgency="$URGENCY" \
      "$TITLE" \
      "$BODY" >/dev/null 2>&1 && return 0
  done < <(target_users | awk 'NF' | sort -u)

  return 1
}

play_sound() {
  local user uid bus

  [[ "$URGENCY" != "low" ]] || return 0

  while read -r user; do
    [[ -n "$user" ]] || continue
    uid="$(id -u "$user" 2>/dev/null || true)"
    [[ "$uid" =~ ^[0-9]+$ ]] || continue
    bus="/run/user/$uid/bus"
    [[ -S "$bus" ]] || continue

    if command -v canberra-gtk-play >/dev/null 2>&1; then
      runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
        canberra-gtk-play -i dialog-information -d "VPN notification" >/dev/null 2>&1 || true
      return 0
    fi

    if command -v paplay >/dev/null 2>&1 && [[ -f /usr/share/sounds/freedesktop/stereo/complete.oga ]]; then
      runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$uid" \
        paplay /usr/share/sounds/freedesktop/stereo/complete.oga >/dev/null 2>&1 || true
      return 0
    fi
  done < <(target_users | awk 'NF' | sort -u)

  return 1
}

if (( DRY_RUN == 1 )); then
  printf 'DRY_RUN title=%s urgency=%s body=%s\n' "$TITLE" "$URGENCY" "$BODY"
  exit 0
fi

log_event
send_notify || true
play_sound || true

#!/usr/bin/env bash
set -euo pipefail

VERSION="v0.2.0"
REPORT_DIR="${WATCHDOGVPN_REPORT_DIR:-$HOME}"
TRUTH_BIN="${WATCHDOGVPN_TRUTH_BIN:-/usr/local/bin/vpn_truth_check}"
AUTH_BIN="${WATCHDOGVPN_AUTH_BIN:-/usr/local/bin/vpn_auth_check}"
DNSCTL_BIN="${WATCHDOGVPN_DNSCTL_BIN:-/usr/local/bin/vpn_dnsctl}"
VPNCTL_BIN="${WATCHDOGVPN_VPNCTL_BIN:-/usr/local/bin/vpnctl}"
DOCTOR_BIN="${WATCHDOGVPN_DOCTOR_BIN:-./doctor.sh}"
TUI_BIN="${WATCHDOGVPN_TUI_BIN:-$HOME/.local/bin/VPN}"
CONFIG_FILE="${WATCHDOGVPN_CONFIG_FILE:-/etc/watchdogvpn/config.toml}"
LOG_DIR="${WATCHDOGVPN_LOG_DIR:-/var/log/myvpn}"
LOG_LINES="${WATCHDOGVPN_LOG_LINES:-80}"
REPO_DIR="${WATCHDOGVPN_REPO_DIR:-$(pwd)}"

usage() {
  cat <<'USAGE'
WatchdogVPN command line

Primary command for WatchdogVPN diagnostics, configuration and TUI access.

Usage:
  watchdogvpn <command> [options]

Read-only commands:
  status        Show VPN runtime status through vpnctl.
  doctor        Run repository doctor when available.
  report        Generate a local sanitized diagnostic report.
  logs          Read recent WatchdogVPN logs without sudo.
  update-check  Show local repository update status without network access.
  config get    Read persistent WatchdogVPN configuration.
  version       Print command version.
  help          Show this help.

Configuration commands:
  config set    Update a validated safe configuration key.
  config reset  Reset safe configuration sections. Requires --yes.

Interactive commands:
  tui           Open the WatchdogVPN terminal UI.

Common examples:
  watchdogvpn status
  watchdogvpn report
  watchdogvpn logs
  watchdogvpn update-check
  watchdogvpn logs watchdog 120
  watchdogvpn config get language.current
  watchdogvpn config set tui.theme high_contrast
  watchdogvpn config reset tui --yes
  watchdogvpn tui

Safety:
  report writes a local file only. Nothing is uploaded automatically.
  logs reads local files only and sanitizes obvious sensitive values.
  update-check does not fetch, pull, push, update runtime files or use sudo.
  config set/reset creates a backup before modifying configuration.
  update, connect, disconnect and rotate are intentionally not product CLI
  commands yet.
USAGE
}

log_path() {
  case "$1" in
    events) printf '%s/vpn-events.log\n' "$LOG_DIR" ;;
    watchdog) printf '%s/vpn-watchdog.log\n' "$LOG_DIR" ;;
    rotate) printf '%s/vpn-rotate.log\n' "$LOG_DIR" ;;
    dispatcher) printf '%s/vpn-dispatcher.log\n' "$LOG_DIR" ;;
    *) return 1 ;;
  esac
}

logs_usage() {
  cat <<'USAGE'
Usage:
  watchdogvpn logs [events|watchdog|rotate|dispatcher] [lines]

Reads recent local WatchdogVPN logs without sudo and sanitizes obvious
sensitive values. Defaults to:
  watchdogvpn logs events 80
USAGE
}

logs_command() {
  local target="${1:-events}" lines="${2:-$LOG_LINES}" path

  case "$target" in
    help|--help|-h)
      logs_usage
      return 0
      ;;
  esac

  if ! [[ "$lines" =~ ^[0-9]+$ ]] || ((lines < 1 || lines > 500)); then
    printf 'invalid log line count: %s\n' "$lines" >&2
    return 64
  fi

  path="$(log_path "$target")" || {
    printf 'unknown log target: %s\n\n' "$target" >&2
    logs_usage >&2
    return 64
  }

  printf 'WatchdogVPN logs: %s\n' "$target"
  printf 'Source: %s\n' "$path"
  printf 'Lines: %s\n\n' "$lines"

  if [[ ! -e "$path" ]]; then
    printf 'log unavailable: %s\n' "$path" >&2
    return 66
  fi
  if [[ ! -r "$path" ]]; then
    printf 'log not readable without sudo: %s\n' "$path" >&2
    return 77
  fi

  tail -n "$lines" "$path" | sanitize_stream
}

sanitize_stream() {
  sed -E \
    -e "s#${HOME}#<home>#g" \
    -e 's#(https?://)[^/@[:space:]]+@#\1<redacted>@#g' \
    -e 's#https?://[^[:space:]]*device_code[^[:space:]]*#<redacted-device-code-url>#g' \
    -e 's/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}/<redacted-email>/g' \
    -e 's/([0-9]{1,3}\.){3}[0-9]{1,3}/<redacted-ip>/g'
}

sanitize_remote_url() {
  sed -E -e 's#(https?://)[^/@[:space:]]+@#\1<redacted>@#g'
}

git_repo_command() {
  git -C "$REPO_DIR" "$@" 2>/dev/null || true
}

git_repo_available() {
  command -v git >/dev/null 2>&1 && git -C "$REPO_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

update_check() {
  local repo_root branch commit upstream origin status_line dirty latest_tag counts ahead behind sync_state

  printf 'WatchdogVPN update check\n'
  printf 'Mode: read-only. No fetch, pull, push, update.sh or sudo is executed.\n\n'
  printf 'Version: %s\n' "$VERSION"

  if ! git_repo_available; then
    printf 'Repository: unavailable\n'
    printf 'State: not a git checkout\n'
    return 0
  fi

  repo_root="$(git_repo_command rev-parse --show-toplevel)"
  branch="$(git_repo_command branch --show-current)"
  commit="$(git_repo_command rev-parse --short HEAD)"
  upstream="$(git_repo_command rev-parse --abbrev-ref --symbolic-full-name '@{u}')"
  origin="$(git_repo_command config --get remote.origin.url)"
  status_line="$(git_repo_command status --short --branch | sed -n '1p')"
  latest_tag="$(git_repo_command describe --tags --abbrev=0)"

  if [[ -n "$(git_repo_command status --porcelain)" ]]; then
    dirty="dirty"
  else
    dirty="clean"
  fi

  ahead=0
  behind=0
  sync_state="no upstream"
  if [[ -n "$upstream" ]]; then
    counts="$(git_repo_command rev-list --left-right --count 'HEAD...@{u}')"
    if [[ "$counts" =~ ^([0-9]+)[[:space:]]+([0-9]+)$ ]]; then
      ahead="${BASH_REMATCH[1]}"
      behind="${BASH_REMATCH[2]}"
      if ((ahead > 0 && behind > 0)); then
        sync_state="diverged"
      elif ((behind > 0)); then
        sync_state="behind"
      elif ((ahead > 0)); then
        sync_state="ahead"
      else
        sync_state="up to date"
      fi
    else
      sync_state="unknown"
    fi
  fi

  printf 'Repository: %s\n' "${repo_root:-unknown}" | sanitize_stream
  printf 'Branch: %s\n' "${branch:-unknown}"
  printf 'Commit: %s\n' "${commit:-unknown}"
  printf 'Upstream: %s\n' "${upstream:-none}"
  printf 'Origin: %s\n' "${origin:-none}" | sanitize_remote_url
  printf 'Remote state: %s\n' "$sync_state"
  printf 'Local changes: %s\n' "$dirty"
  printf 'Ahead/behind: '
  if [[ -n "$upstream" ]]; then
    printf '%s/%s\n' "$ahead" "$behind"
  else
    printf 'unknown\n'
  fi
  printf 'Latest local tag: %s\n' "${latest_tag:-unknown}"
  printf 'Git status: %s\n' "${status_line:-unknown}"

  printf '\nNext step:\n'
  case "$dirty:$sync_state" in
    dirty:*)
      printf '  Review local changes before updating: git status --short\n'
      ;;
    clean:behind)
      printf '  Source checkout can be fast-forwarded: git pull --ff-only origin main\n'
      ;;
    clean:up\ to\ date)
      printf '  Source checkout appears current against the local upstream metadata.\n'
      ;;
    clean:ahead)
      printf '  Local branch has unpublished commits: git push origin main\n'
      ;;
    clean:diverged)
      printf '  Branch diverged. Inspect history before pulling or pushing.\n'
      ;;
    clean:no\ upstream)
      printf '  Configure upstream if this checkout should track origin/main.\n'
      ;;
    *)
      printf '  Inspect repository state manually before updating.\n'
      ;;
  esac
}

section() {
  printf '\n== %s ==\n' "$1"
}

run_report_command() {
  local title="$1"
  shift
  section "$title"
  if command -v "$1" >/dev/null 2>&1 || [[ -x "$1" ]]; then
    "$@" 2>&1 | sanitize_stream || printf 'command failed: %s\n' "$*"
  else
    printf 'command unavailable: %s\n' "$1"
  fi
}

run_shell_report_command() {
  local title="$1" command_text="$2"
  section "$title"
  bash -c "$command_text" 2>&1 | sanitize_stream || printf 'command failed: %s\n' "$command_text"
}

git_commit() {
  if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git rev-parse --short HEAD 2>/dev/null || true
  fi
}

generate_report() {
  local stamp report commit
  stamp="$(date +%Y%m%d-%H%M%S)"
  report="$REPORT_DIR/watchdogvpn-report-$stamp.txt"
  commit="$(git_commit)"

  {
    printf 'WatchdogVPN diagnostic report\n'
    printf 'Generated: %s\n' "$(date -Is)"
    printf 'Version: %s\n' "$VERSION"
    [[ -n "$commit" ]] && printf 'Repository commit: %s\n' "$commit"
    printf 'Note: this file is local only. Review it before sharing.\n'

    section "System"
    printf 'User: <redacted-user>\n'
    printf 'Hostname: <redacted-host>\n'
    printf 'Kernel: %s\n' "$(uname -srmo 2>/dev/null || true)"
    if [[ -r /etc/os-release ]]; then
      grep -E '^(PRETTY_NAME|ID|ID_LIKE)=' /etc/os-release 2>/dev/null | sanitize_stream || true
    fi

    run_report_command "VPN truth" "$TRUTH_BIN"
    run_report_command "VPN auth" "$AUTH_BIN"
    run_report_command "VPN status" "$VPNCTL_BIN" status
    run_report_command "DNS current" "$DNSCTL_BIN" current
    run_report_command "DNS local test" "$DNSCTL_BIN" local-test

    run_shell_report_command "Systemd units" \
      "systemctl --no-pager --plain status adguardvpn.service vpn-watchdog.timer vpn-rotate.timer vpn-domain-bypass.timer myvpn-logrotate.timer"
    run_shell_report_command "Timers" \
      "systemctl list-timers --all vpn-watchdog.timer vpn-rotate.timer vpn-domain-bypass.timer myvpn-logrotate.timer --no-pager"
    run_shell_report_command "Recent WatchdogVPN events" \
      "sudo -n tail -n 80 /var/log/myvpn/vpn-events.log 2>/dev/null || tail -n 80 /var/log/myvpn/vpn-events.log 2>/dev/null || true"
  } >"$report"

  printf 'Report written: %s\n' "$report"
  printf 'Review this file before sharing it. Nothing was uploaded.\n'
}

config_value() {
  local key="$1" file="${2:-$CONFIG_FILE}" section name
  section="${key%%.*}"
  name="${key#*.}"

  [[ "$section" != "$key" && -n "$section" && -n "$name" ]] || return 64
  [[ -r "$file" ]] || return 66

  awk -v section="$section" -v name="$name" '
    $0 ~ "^[[:space:]]*\\[" section "\\][[:space:]]*$" {in_section=1; next}
    $0 ~ "^[[:space:]]*\\[[^]]+\\][[:space:]]*$" {in_section=0}
    in_section && $0 ~ "^[[:space:]]*" name "[[:space:]]*=" {
      sub(/^[^=]*=[[:space:]]*/, "")
      gsub(/^[[:space:]]+|[[:space:]]+$/, "")
      gsub(/^"|"$/, "")
      print
      found=1
      exit
    }
    END {exit found ? 0 : 1}
  ' "$file"
}

config_key_allowed() {
  case "$1" in
    language.current|language.auto_detect|tui.theme|tui.color|tui.unicode|reporting.sanitize_ipv4|reporting.sanitize_ipv6|reporting.sanitize_email|reporting.sanitize_home)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

config_validate_value() {
  local key="$1" value="$2"
  case "$key" in
    language.current)
      case "$value" in
        en|es|ru|fa|zh_CN|ar|fr) return 0 ;;
      esac
      ;;
    language.auto_detect|tui.color|tui.unicode|reporting.sanitize_ipv4|reporting.sanitize_ipv6|reporting.sanitize_email|reporting.sanitize_home)
      case "$value" in
        true|false) return 0 ;;
      esac
      ;;
    tui.theme)
      case "$value" in
        default|high_contrast|no_color) return 0 ;;
      esac
      ;;
  esac
  return 1
}

config_format_value() {
  local key="$1" value="$2"
  case "$key" in
    language.current|tui.theme)
      printf '"%s"\n' "$value"
      ;;
    *)
      printf '%s\n' "$value"
      ;;
  esac
}

config_default_value() {
  local key="$1" section name
  section="${key%%.*}"
  name="${key#*.}"

  [[ "$section" != "$key" && -n "$section" && -n "$name" ]] || return 64
  awk -v section="$section" -v name="$name" '
    $0 ~ "^[[:space:]]*\\[" section "\\][[:space:]]*$" {in_section=1; next}
    $0 ~ "^[[:space:]]*\\[[^]]+\\][[:space:]]*$" {in_section=0}
    in_section && $0 ~ "^[[:space:]]*" name "[[:space:]]*=" {
      sub(/^[^=]*=[[:space:]]*/, "")
      gsub(/^[[:space:]]+|[[:space:]]+$/, "")
      gsub(/^"|"$/, "")
      print
      found=1
      exit
    }
    END {exit found ? 0 : 1}
  ' "${WATCHDOGVPN_CONFIG_DEFAULTS:-/etc/watchdogvpn/config.toml.example}"
}

config_backup() {
  local stamp backup_dir backup counter
  stamp="$(date +%Y%m%d-%H%M%S)"
  backup_dir="${WATCHDOGVPN_CONFIG_BACKUP_DIR:-$(dirname "$CONFIG_FILE")}"
  backup="$backup_dir/$(basename "$CONFIG_FILE").$stamp.bak"
  counter=1
  while [[ -e "$backup" ]]; do
    backup="$backup_dir/$(basename "$CONFIG_FILE").$stamp.$counter.bak"
    counter=$((counter + 1))
  done
  install -d -m 0755 "$backup_dir"
  cp -a "$CONFIG_FILE" "$backup"
  printf 'Backup written: %s\n' "$backup" >&2
}

config_get() {
  local key="${1:-}"

  if [[ ! -r "$CONFIG_FILE" ]]; then
    printf 'config unavailable: %s\n' "$CONFIG_FILE" >&2
    return 66
  fi

  if [[ -z "$key" ]]; then
    sanitize_stream <"$CONFIG_FILE"
    return 0
  fi

  if ! config_value "$key" "$CONFIG_FILE"; then
    printf 'config key not found: %s\n' "$key" >&2
    return 1
  fi
}

config_write_value() {
  local key="$1" value="$2" section name formatted tmp
  section="${key%%.*}"
  name="${key#*.}"
  formatted="$(config_format_value "$key" "$value")"
  tmp="$(mktemp)"

  awk -v section="$section" -v name="$name" -v value="$formatted" '
    $0 ~ "^[[:space:]]*\\[" section "\\][[:space:]]*$" {in_section=1; print; next}
    $0 ~ "^[[:space:]]*\\[[^]]+\\][[:space:]]*$" {in_section=0}
    in_section && $0 ~ "^[[:space:]]*" name "[[:space:]]*=" {
      print name " = " value
      changed=1
      next
    }
    {print}
    END {exit changed ? 0 : 1}
  ' "$CONFIG_FILE" >"$tmp"
  install -m 0644 "$tmp" "$CONFIG_FILE"
  rm -f "$tmp"
}

config_set() {
  local key="${1:-}" value="${2:-}" section name
  section="${key%%.*}"
  name="${key#*.}"

  [[ -n "$key" && -n "$value" && "$section" != "$key" ]] || {
    printf 'usage: watchdogvpn config set section.key value\n' >&2
    return 64
  }
  [[ -r "$CONFIG_FILE" && -w "$CONFIG_FILE" ]] || {
    printf 'config not writable: %s\n' "$CONFIG_FILE" >&2
    return 66
  }
  config_key_allowed "$key" || {
    printf 'config key is not writable: %s\n' "$key" >&2
    return 64
  }
  config_validate_value "$key" "$value" || {
    printf 'invalid value for %s: %s\n' "$key" "$value" >&2
    return 65
  }
  config_value "$key" "$CONFIG_FILE" >/dev/null || {
    printf 'config key not found: %s\n' "$key" >&2
    return 1
  }

  config_backup
  config_write_value "$key" "$value"
  printf '%s updated\n' "$key"
}

config_reset_keys() {
  local target="$1"
  case "$target" in
    all)
      printf '%s\n' \
        language.current \
        language.auto_detect \
        tui.theme \
        tui.color \
        tui.unicode \
        reporting.sanitize_ipv4 \
        reporting.sanitize_ipv6 \
        reporting.sanitize_email \
        reporting.sanitize_home
      ;;
    language)
      printf '%s\n' language.current language.auto_detect
      ;;
    tui)
      printf '%s\n' tui.theme tui.color tui.unicode
      ;;
    reporting)
      printf '%s\n' reporting.sanitize_ipv4 reporting.sanitize_ipv6 reporting.sanitize_email reporting.sanitize_home
      ;;
    *)
      return 1
      ;;
  esac
}

config_reset() {
  local target="${1:-all}" confirm="${2:-}" key default

  [[ "$confirm" == "--yes" ]] || {
    printf 'config reset requires --yes confirmation\n' >&2
    return 64
  }
  [[ -r "$CONFIG_FILE" && -w "$CONFIG_FILE" ]] || {
    printf 'config not writable: %s\n' "$CONFIG_FILE" >&2
    return 66
  }
  [[ -r "${WATCHDOGVPN_CONFIG_DEFAULTS:-/etc/watchdogvpn/config.toml.example}" ]] || {
    printf 'config defaults unavailable: %s\n' "${WATCHDOGVPN_CONFIG_DEFAULTS:-/etc/watchdogvpn/config.toml.example}" >&2
    return 66
  }

  config_reset_keys "$target" >/dev/null || {
    printf 'config reset target is not supported: %s\n' "$target" >&2
    return 64
  }

  config_backup
  while IFS= read -r key; do
    default="$(config_default_value "$key")"
    config_validate_value "$key" "$default" || {
      printf 'invalid default for %s: %s\n' "$key" "$default" >&2
      return 65
    }
    config_write_value "$key" "$default"
  done < <(config_reset_keys "$target")
  printf '%s reset\n' "$target"
}

config_command() {
  local subcmd="${1:-help}"
  shift || true

  case "$subcmd" in
    get)
      config_get "${1:-}"
      ;;
    set)
      config_set "${1:-}" "${2:-}"
      ;;
    reset)
      config_reset "${1:-all}" "${2:-}"
      ;;
    help|--help|-h)
      printf 'Usage: watchdogvpn config get [section.key]\n'
      printf '       watchdogvpn config set section.key value\n'
      printf '       watchdogvpn config reset [language|tui|reporting|all] --yes\n'
      ;;
    *)
      printf 'unknown config command: %s\n\n' "$subcmd" >&2
      printf 'Usage: watchdogvpn config get [section.key]\n' >&2
      printf '       watchdogvpn config set section.key value\n' >&2
      printf '       watchdogvpn config reset [language|tui|reporting|all] --yes\n' >&2
      return 64
      ;;
  esac
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  status)
    exec "$VPNCTL_BIN" status "$@"
    ;;
  doctor)
    if [[ -x "$DOCTOR_BIN" ]]; then
      exec "$DOCTOR_BIN" "$@"
    fi
    printf 'doctor unavailable from this directory. Run from the WatchdogVPN repository root.\n' >&2
    exit 1
    ;;
  tui)
    exec "$TUI_BIN" "$@"
    ;;
  report)
    generate_report
    ;;
  logs)
    logs_command "$@"
    ;;
  update-check)
    update_check
    ;;
  config)
    config_command "$@"
    ;;
  version)
    printf 'WatchdogVPN %s\n' "$VERSION"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    printf 'unknown command: %s\n\n' "$cmd" >&2
    usage >&2
    exit 64
    ;;
esac

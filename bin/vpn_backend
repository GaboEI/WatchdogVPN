#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${WATCHDOGVPN_CONFIG_FILE:-/etc/watchdogvpn/config.toml}"
DEFAULT_BACKEND="adguard"
DEFAULT_MODE="adguard"

usage() {
  cat <<'USAGE'
Uso:
  vpn_backend active
  vpn_backend mode
  vpn_backend validate
  vpn_backend implemented
  vpn_backend status
  vpn_backend supports-rotation
  vpn_backend truth-interface
  vpn_backend service-name
  vpn_backend configured

Contrato:
  "adguard" usa AdGuard VPN CLI.
  "custom-vps" es experimental y controla un servicio local configurado por el
  usuario. No guarda secretos ni instala protocolos por si solo.
USAGE
}

config_value() {
  local key="$1" file="${2:-$CONFIG_FILE}" section name
  section="${key%%.*}"
  name="${key#*.}"

  [[ "$section" != "$key" && -n "$section" && -n "$name" ]] || return 64
  [[ -r "$file" ]] || return 1

  awk -v section="$section" -v name="$name" '
    $0 ~ "^[[:space:]]*\\[" section "\\][[:space:]]*$" {in_section=1; next}
    $0 ~ "^[[:space:]]*\\[[^]]+\\][[:space:]]*$" {in_section=0}
    in_section && $0 ~ "^[[:space:]]*" name "[[:space:]]*=" {
      sub(/^[^=]*=[[:space:]]*/, "")
      gsub(/^[[:space:]]+|[[:space:]]+$/, "")
      gsub(/^"|"$/, "")
      print
      found=1
      exit
    }
    END {exit found ? 0 : 1}
  ' "$file"
}

active_backend() {
  local backend
  backend="$(config_value backend.active 2>/dev/null || true)"
  printf '%s\n' "${backend:-$DEFAULT_BACKEND}"
}

backend_mode() {
  local mode
  mode="$(config_value backend.mode 2>/dev/null || true)"
  printf '%s\n' "${mode:-$DEFAULT_MODE}"
}

custom_vps_enabled() {
  local enabled
  enabled="$(config_value custom_vps.enabled 2>/dev/null || true)"
  printf '%s\n' "${enabled:-false}"
}

custom_vps_service_name() {
  local service
  service="$(config_value custom_vps.service_name 2>/dev/null || true)"
  printf '%s\n' "$service"
}

custom_vps_interface() {
  local iface
  iface="$(config_value custom_vps.interface 2>/dev/null || true)"
  printf '%s\n' "$iface"
}

valid_systemd_service_name() {
  local service="${1:-}"
  [[ "$service" =~ ^[A-Za-z0-9_.@:-]+\.service$ ]]
}

custom_vps_configured() {
  local service
  service="$(custom_vps_service_name)"
  [[ "$(custom_vps_enabled)" == "true" ]] || return 1
  valid_systemd_service_name "$service"
}

implemented_backend() {
  case "$(active_backend)" in
    adguard) printf 'true\n' ;;
    custom-vps)
      if custom_vps_configured; then
        printf 'true\n'
      else
        printf 'false\n'
      fi
      ;;
    *) printf 'false\n' ;;
  esac
}

validate_backend() {
  local backend service
  backend="$(active_backend)"
  case "$backend" in
    adguard)
      return 0
      ;;
    custom-vps)
      if [[ "$(custom_vps_enabled)" != "true" ]]; then
        printf 'backend custom-vps is active but custom_vps.enabled is not true\n' >&2
        return 65
      fi
      service="$(custom_vps_service_name)"
      if [[ -z "$service" ]]; then
        printf 'backend custom-vps requires custom_vps.service_name\n' >&2
        return 65
      fi
      if ! valid_systemd_service_name "$service"; then
        printf 'backend custom-vps has invalid service_name: %s\n' "$service" >&2
        return 65
      fi
      return 0
      ;;
    *)
      printf 'unsupported backend: %s\n' "$backend" >&2
      printf 'implemented backends: adguard custom-vps\n' >&2
      return 65
      ;;
  esac
}

supports_rotation() {
  case "$(active_backend)" in
    adguard) printf 'true\n' ;;
    *) printf 'false\n' ;;
  esac
}

truth_interface() {
  case "$(active_backend)" in
    adguard) printf 'tun0\n' ;;
    custom-vps)
      local iface
      iface="$(custom_vps_interface)"
      printf '%s\n' "${iface:-unknown}"
      ;;
    *) printf 'unknown\n' ;;
  esac
}

status() {
  local backend
  backend="$(active_backend)"
  printf 'MODE=%s\n' "$(backend_mode)"
  printf 'BACKEND=%s\n' "$backend"
  printf 'CUSTOM_VPS_ENABLED=%s\n' "$(custom_vps_enabled)"
  if custom_vps_configured; then
    printf 'CUSTOM_VPS_CONFIGURED=true\n'
  else
    printf 'CUSTOM_VPS_CONFIGURED=false\n'
  fi
  printf 'CUSTOM_VPS_SERVICE_NAME=%s\n' "$(custom_vps_service_name)"
  printf 'CUSTOM_VPS_INTERFACE=%s\n' "$(custom_vps_interface)"
  printf 'IMPLEMENTED=%s\n' "$(implemented_backend)"
  printf 'SUPPORTS_ROTATION=%s\n' "$(supports_rotation)"
  printf 'TRUTH_INTERFACE=%s\n' "$(truth_interface)"
}

case "${1:-status}" in
  active)
    active_backend
    ;;
  mode)
    backend_mode
    ;;
  implemented)
    implemented_backend
    ;;
  validate)
    validate_backend
    ;;
  status)
    status
    ;;
  supports-rotation)
    supports_rotation
    ;;
  truth-interface)
    truth_interface
    ;;
  service-name)
    validate_backend >/dev/null
    custom_vps_service_name
    ;;
  configured)
    if custom_vps_configured; then
      printf 'true\n'
    else
      printf 'false\n'
      exit 1
    fi
    ;;
  --help|-h|help)
    usage
    ;;
  *)
    usage >&2
    exit 64
    ;;
esac

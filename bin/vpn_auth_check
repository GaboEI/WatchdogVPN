#!/usr/bin/env bash
set -euo pipefail

MODE="shell"
CLI="${ADGUARDVPN_CLI:-/usr/local/bin/adguardvpn-cli}"
AS_USER="${ADGUARDVPN_USER:-adgvpn}"
TIMEOUT_SECONDS="${VPN_AUTH_TIMEOUT:-8}"

usage() {
  cat <<'USAGE'
Uso:
  vpn_auth_check [--shell]
  vpn_auth_check --quiet
  vpn_auth_check --json
  vpn_auth_check --help

Estados:
  AUTH=OK       La sesion de AdGuard VPN del usuario de servicio esta vigente.
  AUTH=EXPIRED  El CLI pide login o devuelve error de autenticacion.
  AUTH=UNKNOWN  No se pudo comprobar de forma confiable.
USAGE
}

json_escape() {
  local s="${1:-}"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

parse_args() {
  if (( $# > 1 )); then
    echo "ERROR: demasiados argumentos." >&2
    usage >&2
    exit 64
  fi

  case "${1:---shell}" in
    --shell|"")
      MODE="shell"
      ;;
    --quiet|-q)
      MODE="quiet"
      ;;
    --json)
      MODE="json"
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: argumento no reconocido: $1" >&2
      usage >&2
      exit 64
      ;;
  esac
}

auth_exit_code() {
  case "${1:-UNKNOWN}" in
    OK) echo 0 ;;
    EXPIRED) echo 2 ;;
    UNKNOWN) echo 3 ;;
    *) echo 3 ;;
  esac
}

emit_shell() {
  printf 'AUTH=%s\n' "$AUTH"
  printf 'REASON=%s\n' "$REASON"
  printf 'CLI_RC=%s\n' "$CLI_RC"
  printf 'DETAIL=%s\n' "$DETAIL"
}

emit_json() {
  cat <<JSON
{"schema":"vpn_auth_check.v1","auth":"$(json_escape "$AUTH")","reason":"$(json_escape "$REASON")","cli_rc":$(json_escape "$CLI_RC"),"detail":"$(json_escape "$DETAIL")","exit_code":$(auth_exit_code "$AUTH")}
JSON
}

collect_auth() {
  local out rc status_out status_rc

  AUTH="UNKNOWN"
  REASON="not_checked"
  CLI_RC="0"
  DETAIL=""

  if [[ ! -x "$CLI" ]]; then
    AUTH="UNKNOWN"
    REASON="cli_missing"
    CLI_RC="127"
    DETAIL="$CLI no ejecutable"
    return 0
  fi

  if ! command -v sudo >/dev/null 2>&1; then
    AUTH="UNKNOWN"
    REASON="sudo_missing"
    CLI_RC="127"
    DETAIL="sudo no disponible"
    return 0
  fi

  set +e
  out="$(timeout "${TIMEOUT_SECONDS}s" sudo -n -u "$AS_USER" -H "$CLI" license 2>&1)"
  rc=$?
  set -e

  CLI_RC="$rc"
  DETAIL="$(printf '%s' "$out" | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"

  if (( rc == 0 )); then
    AUTH="OK"
    REASON="license_valid"
    return 0
  fi

  if (( rc == 11 )) || [[ "$DETAIL" == *"Please log in"* ]] || [[ "$DETAIL" == *"not logged in"* ]] || [[ "$DETAIL" == *"login"* ]]; then
    AUTH="EXPIRED"
    REASON="login_required"
    return 0
  fi

  if (( rc == 124 )); then
    AUTH="UNKNOWN"
    REASON="timeout"
    return 0
  fi

  if [[ "$DETAIL" == *"a password is required"* || "$DETAIL" == *"terminal is required"* ]]; then
    AUTH="UNKNOWN"
    REASON="sudo_required"
    return 0
  fi

  set +e
  status_out="$(timeout "${TIMEOUT_SECONDS}s" sudo -n -u "$AS_USER" -H "$CLI" status 2>&1)"
  status_rc=$?
  set -e

  if (( status_rc == 0 )) && [[ "$status_out" != *"not logged in"* ]] && [[ "$status_out" != *"Please log in"* ]]; then
    AUTH="OK"
    REASON="status_available"
    DETAIL="$DETAIL | status=$(printf '%s' "$status_out" | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
    return 0
  fi

  if (( status_rc == 11 )) || [[ "$status_out" == *"not logged in"* ]] || [[ "$status_out" == *"Please log in"* ]]; then
    AUTH="EXPIRED"
    REASON="login_required"
    DETAIL="$DETAIL | status=$(printf '%s' "$status_out" | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
    return 0
  fi

  AUTH="UNKNOWN"
  REASON="cli_error"
}

main() {
  parse_args "$@"
  collect_auth

  case "$MODE" in
    shell)
      emit_shell
      ;;
    quiet)
      exit "$(auth_exit_code "$AUTH")"
      ;;
    json)
      emit_json
      ;;
  esac
}

AUTH="UNKNOWN"
REASON="not_checked"
CLI_RC="0"
DETAIL=""

main "$@"

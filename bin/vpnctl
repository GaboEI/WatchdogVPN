#!/usr/bin/env bash
set -euo pipefail

CMD="${1:-}"
shift || true

AG="${VPNCTL_ADGUARDVPN_CLI:-/usr/local/bin/adguardvpn-cli}"
TRUTH="${VPNCTL_TRUTH_BIN:-/usr/local/bin/vpn_truth_check}"
BACKEND_BIN="${VPNCTL_BACKEND_BIN:-/usr/local/bin/vpn_backend}"
VPN_SET="${VPNCTL_VPN_SET:-/usr/local/sbin/vpn_set}"
MANUAL_STATE="${VPNCTL_MANUAL_STATE_BIN:-/usr/local/bin/vpn_manual_state}"
NOTIFY_BIN="${VPNCTL_NOTIFY_BIN:-/usr/local/bin/vpn_notify}"
RUN_AS_ADGVPN=(sudo -u adgvpn -H "$AG")
AUTOMATION_UNITS=(
  vpn-watchdog.timer
  vpn-rotate.timer
  vpn-rotate-firstboot.timer
  vpn-watchdog.service
  vpn-rotate.service
)

current_location() {
  sudo sed -n 's/^LOCATION="\?\([^"]*\)"\?/\1/p' /etc/adguardvpn.env 2>/dev/null | head -n1 || true
}

valid_location_hint() {
  local loc="${1:-}"
  [[ "$loc" =~ ^[A-Za-z]{2}$ ]]
}

active_backend() {
  if [[ -x "$BACKEND_BIN" ]]; then
    "$BACKEND_BIN" active
  else
    printf 'adguard\n'
  fi
}

validate_backend() {
  if [[ -x "$BACKEND_BIN" ]]; then
    "$BACKEND_BIN" validate
  else
    return 0
  fi
}

backend_supports_rotation() {
  if [[ -x "$BACKEND_BIN" ]]; then
    "$BACKEND_BIN" supports-rotation 2>/dev/null || printf 'true\n'
  else
    printf 'true\n'
  fi
}

backend_service_name() {
  if [[ -x "$BACKEND_BIN" ]]; then
    "$BACKEND_BIN" service-name
  fi
}

load_truth() {
  local line
  while IFS= read -r line; do
    [[ "$line" == *=* ]] || continue
    key="${line%%=*}"
    val="${line#*=}"
    case "$key" in
      STATUS|TUN|ROUTE|IP|IP_ADDR)
        printf -v "$key" '%s' "$val"
        ;;
    esac
  done < <("$TRUTH")
}

manual_off_active() {
  [[ -x "$MANUAL_STATE" ]] && "$MANUAL_STATE" is-manual-off >/dev/null 2>&1
}

clear_manual_off() {
  [[ -x "$MANUAL_STATE" ]] && sudo "$MANUAL_STATE" clear || true
}

set_manual_off() {
  if [[ -x "$MANUAL_STATE" ]]; then
    sudo "$MANUAL_STATE" set-manual-off user-request "$(active_backend)"
  fi
}

pause_automation() {
  sudo systemctl stop "${AUTOMATION_UNITS[@]}" >/dev/null 2>&1 || true
}

resume_automation() {
  if [[ "$(backend_supports_rotation)" == "true" ]]; then
    sudo systemctl start vpn-watchdog.timer vpn-rotate.timer >/dev/null 2>&1 || true
  else
    sudo systemctl start vpn-watchdog.timer >/dev/null 2>&1 || true
  fi
}

network_after_disconnect_summary() {
  local route dns
  route="$(ip route get 1.1.1.1 2>/dev/null | sed -n '1p' || true)"
  if getent hosts example.com >/dev/null 2>&1; then
    dns="OK"
  else
    dns="FAIL"
  fi
  echo "Ruta normal: ${route:-no disponible}"
  echo "DNS sin VPN: ${dns}"
}

custom_service_status() {
  local service="$1" active enabled
  active="$(systemctl is-active "$service" 2>/dev/null || true)"
  enabled="$(systemctl is-enabled "$service" 2>/dev/null || true)"
  echo "🧩 service: ${service}"
  echo "⚙️ systemd: ${active:-unknown} / ${enabled:-unknown}"
}

case "$CMD" in
  status)
    validate_backend
    BACKEND="$(active_backend)"
    STATUS="DOWN"
    TUN="DOWN"
    ROUTE="UNKNOWN"
    IP="FAIL"
    IP_ADDR="none"
    load_truth

    if [[ "$BACKEND" == "adguard" ]]; then
      cli_status="$("${RUN_AS_ADGVPN[@]}" status 2>/dev/null | sed -n '1p' || true)"
      cli_status="${cli_status:-no-response}"
    else
      cli_status="not-applicable"
    fi

    icon="🔴"
    case "$STATUS" in
      UP) icon="🟢" ;;
      DEGRADED) icon="🟡" ;;
      DOWN) icon="🔴" ;;
    esac

    if manual_off_active; then
      echo "🔴 VPN STATUS: OFF (manual-off)"
    else
      echo "${icon} VPN STATUS: ${STATUS} (REAL)"
    fi
    echo "Backend: ${BACKEND}"
    echo
    echo "🧵 tunnel: ${TUN}"
    echo "🧭 route: ${ROUTE}"
    echo "🌍 public ip: ${IP_ADDR}"
    echo
    if [[ "$BACKEND" == "custom-vps" ]]; then
      custom_service_status "$(backend_service_name)"
      echo
      echo "⚠️ CLI status: ${cli_status}"
    else
      echo "⚠️ CLI status: ${cli_status} (no confiable)"
    fi
    ;;

  list)
    validate_backend
    BACKEND="$(active_backend)"
    if [[ "$BACKEND" == "custom-vps" ]]; then
      echo "Custom VPS no expone ubicaciones por CLI en esta fase."
      echo "Servicio: $(backend_service_name)"
      echo "Rotacion: no soportada"
    else
      "${RUN_AS_ADGVPN[@]}" list-locations
    fi
    ;;

  connect)
    validate_backend
    BACKEND="$(active_backend)"
    if [[ "$BACKEND" == "custom-vps" ]]; then
      service="$(backend_service_name)"
      clear_manual_off
      resume_automation
      sudo systemctl start "$service"
      echo "🔐 Custom VPS iniciado"
      echo
      "$0" status
    else
      LOC="${1:-}"
      if [[ -z "$LOC" ]]; then
        echo "❌ Uso: vpnctl connect <ISO/CIUDAD/ID>"
        exit 1
      fi
      clear_manual_off
      resume_automation
      sudo "$VPN_SET" "$LOC"
      echo
      "$0" status
    fi
    ;;

  disconnect)
    validate_backend
    BACKEND="$(active_backend)"
    set_manual_off
    pause_automation
    if [[ "$BACKEND" == "custom-vps" ]]; then
      sudo systemctl stop "$(backend_service_name)"
    else
      sudo systemctl stop adguardvpn.service
      "${RUN_AS_ADGVPN[@]}" disconnect >/dev/null 2>&1 || true
    fi
    "$NOTIFY_BIN" "VPN desconectada" "La conexion VPN fue detenida manualmente." normal >/dev/null 2>&1 || true
    echo "🔓 VPN desconectada"
    echo
    "$0" status
    echo
    network_after_disconnect_summary
    ;;

  restart)
    validate_backend
    BACKEND="$(active_backend)"
    clear_manual_off
    resume_automation
    if [[ "$BACKEND" == "custom-vps" ]]; then
      sudo systemctl restart "$(backend_service_name)"
    else
      loc="$(current_location)"
      if valid_location_hint "$loc"; then
        sudo "$VPN_SET" "$loc"
      else
        sudo systemctl restart adguardvpn.service
      fi
    fi
    echo "🔄 VPN reiniciada"
    echo
    "$0" status
    ;;

  *)
    echo "Uso:"
    echo "  vpnctl status"
    echo "  vpnctl list"
    echo "  vpnctl connect <ISO/CIUDAD/ID>"
    echo "  vpnctl disconnect"
    echo "  vpnctl restart"
    exit 1
    ;;
esac

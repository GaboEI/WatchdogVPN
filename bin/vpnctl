#!/usr/bin/env bash
set -euo pipefail

CMD="${1:-}"
shift || true

TRUTH="${VPNCTL_TRUTH_BIN:-/usr/local/bin/vpn_truth_check}"
BACKEND_BIN="${VPNCTL_BACKEND_BIN:-/usr/local/bin/vpn_backend}"
MANUAL_STATE="${VPNCTL_MANUAL_STATE_BIN:-/usr/local/bin/vpn_manual_state}"
NOTIFY_BIN="${VPNCTL_NOTIFY_BIN:-/usr/local/bin/vpn_notify}"

active_backend() {
  if [[ -x "$BACKEND_BIN" ]]; then
    "$BACKEND_BIN" active
  else
    printf 'custom-vps\n'
  fi
}

validate_backend() {
  if [[ -x "$BACKEND_BIN" ]]; then
    "$BACKEND_BIN" validate
  else
    return 0
  fi
}

backend_service_name() {
  if [[ -x "$BACKEND_BIN" ]]; then
    "$BACKEND_BIN" service-name
  fi
}

load_truth() {
  local line
  while IFS= read -r line; do
    [[ "$line" == *=* ]] || continue
    key="${line%%=*}"
    val="${line#*=}"
    case "$key" in
      STATUS|TUN|ROUTE|IP|IP_ADDR)
        printf -v "$key" '%s' "$val"
        ;;
    esac
  done < <("$TRUTH")
}

manual_off_active() {
  [[ -x "$MANUAL_STATE" ]] && "$MANUAL_STATE" is-manual-off >/dev/null 2>&1
}

clear_manual_off() {
  [[ -x "$MANUAL_STATE" ]] && sudo "$MANUAL_STATE" clear || true
}

set_manual_off() {
  if [[ -x "$MANUAL_STATE" ]]; then
    sudo "$MANUAL_STATE" set-manual-off user-request "$(active_backend)"
  fi
}

network_after_disconnect_summary() {
  local route dns
  route="$(ip route get 1.1.1.1 2>/dev/null | sed -n '1p' || true)"
  if getent hosts example.com >/dev/null 2>&1; then
    dns="OK"
  else
    dns="FAIL"
  fi
  echo "Ruta normal: ${route:-no disponible}"
  echo "DNS sin VPN: ${dns}"
}

custom_service_status() {
  local service="$1" active enabled
  active="$(systemctl is-active "$service" 2>/dev/null || true)"
  enabled="$(systemctl is-enabled "$service" 2>/dev/null || true)"
  echo "🧩 service: ${service}"
  echo "⚙️ systemd: ${active:-unknown} / ${enabled:-unknown}"
}

case "$CMD" in
  status)
    BACKEND="$(active_backend)"
    STATUS="DOWN"
    TUN="DOWN"
    ROUTE="UNKNOWN"
    IP="FAIL"
    IP_ADDR="none"
    load_truth

    icon="🔴"
    case "$STATUS" in
      UP) icon="🟢" ;;
      DEGRADED) icon="🟡" ;;
      DOWN) icon="🔴" ;;
    esac

    if manual_off_active; then
      echo "🔴 VPN STATUS: OFF (manual-off)"
    else
      echo "${icon} VPN STATUS: ${STATUS} (REAL)"
    fi
    echo "Backend: ${BACKEND}"
    echo
    echo "🧵 tunnel: ${TUN}"
    echo "🧭 route: ${ROUTE}"
    echo "🌍 public ip: ${IP_ADDR}"
    echo
    service="$(backend_service_name 2>/dev/null || true)"
    if [[ -n "$service" ]]; then
      custom_service_status "$service"
    else
      echo "🧩 service: not configured"
      echo "⚙️ custom-vps: setup required; the v2 daemon status above remains authoritative"
    fi

    # WDCLI-008: the printed status must agree with the real exit code, or
    # a shell health-check trusting only "$?" sees a false UP. Mirrors
    # vpn_truth_check's status_code() mapping; duplicated here (not
    # sourced) since the two are separate executables and this is a small,
    # stable 4-line mapping.
    case "$STATUS" in
      UP) exit 0 ;;
      DEGRADED) exit 1 ;;
      DOWN) exit 2 ;;
      *) exit 3 ;;
    esac
    ;;

  list)
    validate_backend
    echo "Custom VPS no expone ubicaciones por CLI en esta fase."
    echo "Servicio: $(backend_service_name)"
    echo "Rotacion: no soportada"
    ;;

  connect)
    validate_backend
    service="$(backend_service_name)"
    clear_manual_off
    sudo systemctl start "$service"
    echo "🔐 Custom VPS iniciado"
    echo
    # Informational summary only, see the note on the disconnect branch.
    "$0" status || true
    ;;

  disconnect)
    validate_backend
    set_manual_off
    sudo systemctl stop "$(backend_service_name)"
    "$NOTIFY_BIN" "VPN desconectada" "La conexion VPN fue detenida manualmente." normal >/dev/null 2>&1 || true
    echo "🔓 VPN desconectada"
    echo
    # "$0" status is used here purely to print an informational summary,
    # not as a success assertion - a DOWN status right after disconnecting
    # is the expected, correct outcome. Its own exit code (WDCLI-008: now
    # meaningful, matches the printed status) must not abort this command
    # under set -e.
    "$0" status || true
    echo
    network_after_disconnect_summary
    ;;

  restart)
    validate_backend
    clear_manual_off
    sudo systemctl restart "$(backend_service_name)"
    echo "🔄 VPN reiniciada"
    echo
    "$0" status || true
    ;;

  *)
    echo "Uso:"
    echo "  vpnctl status"
    echo "  vpnctl list"
    echo "  vpnctl connect"
    echo "  vpnctl disconnect"
    echo "  vpnctl restart"
    exit 1
    ;;
esac

[Unit]
Description=AdGuard VPN CLI (always-on, fail-open)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=adgvpn
Group=adgvpn
WorkingDirectory=/var/lib/adguardvpn
Environment=HOME=/var/lib/adguardvpn
EnvironmentFile=-/etc/adguardvpn.env

AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
DeviceAllow=/dev/net/tun rw

ExecStart=/bin/sh -c 'exec /usr/local/bin/adguardvpn-cli connect --no-fork -y ${LOCATION:+-l "$LOCATION"}'
ExecStop=/bin/sh -c '/usr/local/bin/adguardvpn-cli disconnect || true'

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

[Unit]
Description=WatchdogVPN daemon
Documentation=https://github.com/GaboEI/WatchdogVPN
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
User=watchdogvpn
Group=watchdogvpn
WorkingDirectory=/var/lib/watchdogvpn

# "wireguard" is a second name, not a typo: wireguard-go/amneziawg-go
# hardcode their userspace configuration socket at /run/wireguard/<iface>.sock
# and mkdir that path themselves. Under ProtectSystem=strict the rest of /run
# is read-only, so without this the socket is never created and awg/wg
# setconf fails with "Unable to modify interface: Protocol not supported"
# even though the userspace TUN interface itself comes up.
RuntimeDirectory=watchdogvpn wireguard
RuntimeDirectoryMode=0750
StateDirectory=watchdogvpn
StateDirectoryMode=2770
ConfigurationDirectory=watchdogvpn
ConfigurationDirectoryMode=0750

Environment=WATCHDOGVPN_RUNTIME_DIR=/run/watchdogvpn
Environment=WATCHDOGVPN_SOCKET_PATH=/run/watchdogvpn/control.sock
Environment=WATCHDOGVPN_EVENT_SOCKET_PATH=/run/watchdogvpn/control.events.sock

AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
UMask=0077

ExecStart=/usr/local/bin/watchdogvpn-daemon
Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

#!/usr/bin/env bash
set -euo pipefail

# NetworkManager dispatcher
# $1 = interface, $2 = action

ACTION="${2:-}"
LOG_FILE="${VPN_DISPATCHER_LOG_FILE:-/var/log/vpn-dispatcher.log}"
LOG_COMPONENT="dispatcher"
ROTATE_SERVICE="vpn-rotate.service"
TRUTH_BIN="/usr/local/bin/vpn_truth_check"
MANUAL_STATE_BIN="${VPN_DISPATCHER_MANUAL_STATE_BIN:-/usr/local/bin/vpn_manual_state}"
STABILIZE_SECONDS="${VPN_DISPATCHER_STABILIZE_SECONDS:-3}"

log() {
  local msg="$*" level="INFO" event first
  case "$msg" in
    ERROR*|*_ERROR*|*ERROR*) level="ERROR" ;;
    WARN*|SKIP*|*FAIL*) level="WARN" ;;
  esac
  first="${msg%% *}"
  first="${first%:}"
  event="$(printf '%s' "$first" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/_/g; s/^_+|_+$//g')"
  [[ -n "$event" ]] || event="message"
  printf '%s | %s | %s | %s | %s\n' "$(date --iso-8601=seconds)" "$LOG_COMPONENT" "$level" "$event" "$msg" >> "$LOG_FILE" 2>/dev/null || true
}

manual_off_active() {
  [[ -x "$MANUAL_STATE_BIN" ]] && "$MANUAL_STATE_BIN" is-manual-off >/dev/null 2>&1
}

check_vpn_health() {
  local key value status="DOWN" tun="DOWN" route="UNKNOWN" ip="FAIL" ip_addr="none"

  [[ -x "$TRUTH_BIN" ]] || {
    printf 'FAIL'
    return 0
  }

  while IFS='=' read -r key value; do
    case "$key" in
      STATUS) status="$value" ;;
      TUN) tun="$value" ;;
      ROUTE) route="$value" ;;
      IP) ip="$value" ;;
      IP_ADDR) ip_addr="$value" ;;
    esac
  done < <("$TRUTH_BIN" 2>/dev/null || true)

  log "TRUTH status='$status' tun='$tun' route='$route' ip='$ip' ip_addr='$ip_addr'"

  if [[ "$status" == "UP" ]]; then
    printf 'OK'
    return 0
  fi

  printf 'FAIL'
}

should_handle_action() {
  case "$ACTION" in
    up|connectivity-change)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

if ! should_handle_action; then
  exit 0
fi

if manual_off_active; then
  log "SKIP manual-off: user requested VPN off action='${ACTION}' interface='${1:-unknown}'"
  exit 0
fi

log "EVENT action='${ACTION}' interface='${1:-unknown}' decision='CHECK'"

sleep "$STABILIZE_SECONDS"

first_state="$(check_vpn_health)"
log "CHECK stage='first' action='${ACTION}' state='${first_state}'"

if [[ "$first_state" == "OK" ]]; then
  log "DECISION action='${ACTION}' result='NO ACTION'"
  exit 0
fi

sleep "$STABILIZE_SECONDS"

second_state="$(check_vpn_health)"
log "CHECK stage='second' action='${ACTION}' state='${second_state}'"

if [[ "$second_state" == "OK" ]]; then
  log "DECISION action='${ACTION}' result='NO ACTION'"
  exit 0
fi

log "DECISION action='${ACTION}' result='ROTATE'"
systemctl start "$ROTATE_SERVICE" >/dev/null 2>&1 || true

#!/usr/bin/env bash
set -euo pipefail

LOC="${1:-}"
NOTIFY_BIN="/usr/local/bin/vpn_notify"
TRUTH_BIN="/usr/local/bin/vpn_truth_check"
MANUAL_STATE_BIN="${VPN_SET_MANUAL_STATE_BIN:-/usr/local/bin/vpn_manual_state}"
NOTIFY_PENDING="${VPN_SET_NOTIFY_PENDING:-1}"

if [[ -z "$LOC" ]]; then
  echo "Uso: vpn_set <ISO|ID|Ciudad>"
  exit 1
fi

if [[ -x "$MANUAL_STATE_BIN" ]]; then
  "$MANUAL_STATE_BIN" clear >/dev/null 2>&1 || true
fi

sudo tee /etc/adguardvpn.env >/dev/null <<ENVEOF
LOCATION="${LOC}"
ENVEOF

sudo systemctl start vpn-watchdog.timer vpn-rotate.timer >/dev/null 2>&1 || true
sudo systemctl restart adguardvpn.service
sleep 3

STATUS="DOWN"
TUN="DOWN"
ROUTE="UNKNOWN"
IP="FAIL"
IP_ADDR="none"

if [[ -x "$TRUTH_BIN" ]]; then
  while IFS='=' read -r key value; do
    case "$key" in
      STATUS|TUN|ROUTE|IP|IP_ADDR)
        printf -v "$key" '%s' "$value"
        ;;
    esac
  done < <("$TRUTH_BIN" 2>/dev/null || true)
fi

echo "Ubicacion solicitada: ${LOC}"
echo "Estado real: ${STATUS}"
echo "tun0: ${TUN}"
echo "route: ${ROUTE}"
echo "ip: ${IP_ADDR}"

location_label() {
  case "${1^^}" in
    AL) echo "Albania" ;;
    AT) echo "Austria" ;;
    AU) echo "Australia" ;;
    BE) echo "Belgica" ;;
    BG) echo "Bulgaria" ;;
    BR) echo "Brasil" ;;
    CA) echo "Canada" ;;
    CH) echo "Suiza" ;;
    CZ) echo "Chequia" ;;
    DE) echo "Alemania" ;;
    DK) echo "Dinamarca" ;;
    EE) echo "Estonia" ;;
    ES) echo "Espana" ;;
    FI) echo "Finlandia" ;;
    FR) echo "Francia" ;;
    GB|UK) echo "Reino Unido" ;;
    GR) echo "Grecia" ;;
    HK) echo "Hong Kong" ;;
    HU) echo "Hungria" ;;
    IE) echo "Irlanda" ;;
    IL) echo "Israel" ;;
    IN) echo "India" ;;
    IS) echo "Islandia" ;;
    IT) echo "Italia" ;;
    JP) echo "Japon" ;;
    KR) echo "Corea del Sur" ;;
    LU) echo "Luxemburgo" ;;
    LV) echo "Letonia" ;;
    NL) echo "Paises Bajos" ;;
    NO) echo "Noruega" ;;
    NZ) echo "Nueva Zelanda" ;;
    PL) echo "Polonia" ;;
    PT) echo "Portugal" ;;
    RO) echo "Rumania" ;;
    RS) echo "Serbia" ;;
    SE) echo "Suecia" ;;
    SG) echo "Singapur" ;;
    TR) echo "Turquia" ;;
    UA) echo "Ucrania" ;;
    US) echo "Estados Unidos" ;;
    *) echo "$1" ;;
  esac
}

LABEL="$(location_label "$LOC")"

if [[ "$STATUS" == "UP" ]]; then
  [[ -x "$NOTIFY_BIN" ]] && "$NOTIFY_BIN" "VPN conectada" "Conectado a ${LABEL}." normal >/dev/null 2>&1 || true
else
  if [[ "$NOTIFY_PENDING" == "1" ]]; then
    [[ -x "$NOTIFY_BIN" ]] && "$NOTIFY_BIN" "VPN cambiando ubicacion" "Solicitada ${LABEL}. Estado real: ${STATUS}." low >/dev/null 2>&1 || true
  fi
fi

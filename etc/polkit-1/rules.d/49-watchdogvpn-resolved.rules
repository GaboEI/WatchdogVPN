// The daemon may flush resolver caches and start only fixed root helpers. The
// helpers accept no caller input; NetworkManager's broad settings action is
// never granted.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.resolve1.flush-caches" &&
        subject.user === "watchdogvpn") {
        return polkit.Result.YES;
    }
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        (action.lookup("unit") === "watchdogvpn-nm-dns-restore.service" ||
         action.lookup("unit") === "watchdogvpn-nm-tun-cleanup.service") &&
        action.lookup("verb") === "start" && subject.user === "watchdogvpn") {
        return polkit.Result.YES;
    }
});

// WatchdogVPN's unprivileged service must manage DNS ownership for the
// resolver stack selected by the host. NetworkManager requires its system
// settings action to restore the captured DNS properties of a system profile.
// Both permissions remain limited to the dedicated service account.
polkit.addRule(function(action, subject) {
    if ((action.id === "org.freedesktop.resolve1.flush-caches" ||
         action.id === "org.freedesktop.NetworkManager.settings.modify.system") &&
        subject.user === "watchdogvpn") {
        return polkit.Result.YES;
    }
});

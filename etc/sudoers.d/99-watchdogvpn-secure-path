# Managed by WatchdogVPN.
#
# sudo's own compiled-in secure_path default excludes /usr/local/bin and
# /usr/local/sbin on several distros (confirmed on Rocky Linux 9, Task
# 23.6.5b: /etc/sudoers ships "Defaults secure_path = /sbin:/bin:/usr/sbin:
# /usr/bin"). Every WatchdogVPN privileged entry point installs to
# /usr/local/bin or /usr/local/sbin (watchdog_panic, vpn_domain_bypass_
# rescue, vpn_domain_bypass_apply.sh, etc.), so "sudo <command>" for any of
# them fails with "command not found" by bare name on those distros, even
# though the same command resolves fine without sudo. bin/watchdog_panic's
# own internal PATH prepend (see its own comment) only helps once sudo has
# already found and started the script; it cannot fix sudo's own lookup of
# the script itself. This is a strict, order-preserving extension of the
# default secure_path, not a replacement - it does not add any new directory
# beyond the two WatchdogVPN itself installs into, and does not weaken which
# directories are searched first.
Defaults secure_path = "/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin"
